+static bool32 SidedexOracleTraceActive(void)
+{
+    static const u8 expected[] = "Sidedex oracle: deterministic smart AI trace";
+    const u8 *actual;
+    u32 i;
+
+    if (gTestRunnerState.test == NULL)
+        return FALSE;
+    actual = (const u8 *)gTestRunnerState.test->name;
+    for (i = 0; expected[i] != 0 && expected[i] == actual[i]; i++)
+        ;
+    return expected[i] == 0 && actual[i] == 0;
+}
+
+static void SidedexOracleTraceBlob(u32 turn, u32 owner, u32 index, const char *kind, const void *data, u32 size)
+{
+    static const char digits[] = "0123456789abcdef";
+    const u8 *bytes = data;
+    char hex[65];
+    u32 offset, i, count;
+
+    for (offset = 0; offset < size; offset += 32)
+    {
+        count = min(32, size - offset);
+        for (i = 0; i < count; i++)
+        {
+            hex[i * 2] = digits[bytes[offset + i] >> 4];
+            hex[i * 2 + 1] = digits[bytes[offset + i] & 0xF];
+        }
+        hex[count * 2] = '\0';
+        Test_MgbaPrintf("ROMTRACE|blob|%d|%d|%d|%s|%d|%s", turn, owner, index, kind, offset / 32, hex);
+    }
+}
+
+static void SidedexOracleTraceSnapshot(const char *phase)
+{
+    u32 battler, side, slot;
+    struct Pokemon *party;
+    u32 turn = gBattleResults.battleTurnCounter;
+
+    Test_MgbaPrintf("ROMTRACE|phase|%d|%s", turn, phase);
+    Test_MgbaPrintf("ROMTRACE|field|%d|%d|%d", turn, gBattleTypeFlags, gBattleWeather);
+    for (side = 0; side < NUM_BATTLE_SIDES; side++)
+    {
+        party = side == B_SIDE_PLAYER ? gPlayerParty : gEnemyParty;
+        for (slot = 0; slot < PARTY_SIZE; slot++)
+        {
+            struct Pokemon *mon = &party[slot];
+            Test_MgbaPrintf("ROMTRACE|party|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d",
+                            turn, side, slot,
+                            GetMonData(mon, MON_DATA_SPECIES, NULL), GetMonData(mon, MON_DATA_HP, NULL),
+                            GetMonData(mon, MON_DATA_STATUS, NULL), GetMonData(mon, MON_DATA_HELD_ITEM, NULL),
+                            GetMonData(mon, MON_DATA_ABILITY_NUM, NULL),
+                            GetMonData(mon, MON_DATA_MOVE1, NULL), GetMonData(mon, MON_DATA_MOVE2, NULL),
+                            GetMonData(mon, MON_DATA_MOVE3, NULL), GetMonData(mon, MON_DATA_MOVE4, NULL),
+                            GetMonData(mon, MON_DATA_PP1, NULL), GetMonData(mon, MON_DATA_PP2, NULL),
+                            GetMonData(mon, MON_DATA_PP3, NULL), GetMonData(mon, MON_DATA_PP4, NULL));
+            SidedexOracleTraceBlob(turn, side, slot, "party-raw", mon, sizeof(*mon));
+        }
+    }
+    for (battler = 0; battler < gBattlersCount; battler++)
+    {
+        const struct BattlePokemon *mon = &gBattleMons[battler];
+        Test_MgbaPrintf("ROMTRACE|active|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d",
+                        turn, battler, gBattleStruct->battlerPartyIndexes[battler],
+                        mon->species, mon->hp, mon->maxHP, mon->status1, mon->status2, gStatuses3[battler],
+                        mon->ability, mon->item,
+                        mon->statStages[0], mon->statStages[1], mon->statStages[2], mon->statStages[3],
+                        mon->statStages[4], mon->statStages[5], mon->statStages[6],
+                        mon->moves[0], mon->moves[1], mon->moves[2], mon->moves[3],
+                        mon->pp[0], mon->pp[1], mon->pp[2], mon->pp[3],
+                        mon->types[0], mon->types[1], mon->types[2]);
+        SidedexOracleTraceBlob(turn, battler, 0, "battle-mon", mon, sizeof(*mon));
+        SidedexOracleTraceBlob(turn, battler, 0, "disable", &gDisableStructs[battler], sizeof(gDisableStructs[battler]));
+        SidedexOracleTraceBlob(turn, battler, 0, "protect", &gProtectStructs[battler], sizeof(gProtectStructs[battler]));
+        SidedexOracleTraceBlob(turn, battler, 0, "special", &gSpecialStatuses[battler], sizeof(gSpecialStatuses[battler]));
+    }
+    for (side = 0; side < NUM_BATTLE_SIDES; side++)
+        SidedexOracleTraceBlob(turn, 2, side, "side-timer", &gSideTimers[side], sizeof(gSideTimers[side]));
+    Test_MgbaPrintf("ROMTRACE|rng|%d|%d|%d|%d|%d|%d|%d|%d|%d",
+                    turn, gRngValue.a, gRngValue.b, gRngValue.c, gRngValue.ctr,
+                    gRng2Value.a, gRng2Value.b, gRng2Value.c, gRng2Value.ctr);
+}
