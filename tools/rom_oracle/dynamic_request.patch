+static bool32 SidedexDynamicMonValid(const volatile struct SidedexDynamicMon *mon)
+{
+    u32 i;
+    bool32 abilityFound = FALSE, sawEmptyMove = FALSE, hasMove = FALSE;
+    u32 evTotal = 0;
+
+    if (mon->species == SPECIES_NONE || mon->species >= NUM_SPECIES
+     || mon->level == 0 || mon->level > MAX_LEVEL
+     || mon->ability >= ABILITIES_COUNT || mon->item >= ITEMS_COUNT
+     || mon->nature >= NUM_NATURES || mon->maxHp == 0 || mon->hp == 0 || mon->hp > mon->maxHp)
+        return FALSE;
+    switch (mon->status1)
+    {
+    case STATUS1_NONE: case STATUS1_POISON: case STATUS1_BURN: case STATUS1_FREEZE:
+    case STATUS1_PARALYSIS: case STATUS1_TOXIC_POISON: case STATUS1_FROSTBITE:
+        break;
+    default:
+        if (mon->status1 < 1 || mon->status1 > STATUS1_SLEEP)
+            return FALSE;
+        break;
+    }
+    for (i = 0; i < NUM_ABILITY_SLOTS; i++)
+        if (gSpeciesInfo[mon->species].abilities[i] == mon->ability)
+            abilityFound = TRUE;
+    if (!abilityFound)
+        return FALSE;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        if (mon->moves[i] == MOVE_NONE)
+        {
+            if (mon->pp[i] != 0)
+                return FALSE;
+            sawEmptyMove = TRUE;
+        }
+        else if (sawEmptyMove || mon->moves[i] >= MOVES_COUNT
+              || mon->pp[i] > gMovesInfo[mon->moves[i]].pp)
+            return FALSE;
+        else
+        {
+            u32 j;
+            for (j = 0; j < i; j++)
+                if (mon->moves[j] == mon->moves[i])
+                    return FALSE;
+            hasMove = TRUE;
+        }
+    }
+    for (i = 0; i < NUM_STATS; i++)
+    {
+        if (mon->ivs[i] > MAX_PER_STAT_IVS || mon->evs[i] > MAX_PER_STAT_EVS)
+            return FALSE;
+        evTotal += mon->evs[i];
+    }
+    return hasMove && evTotal <= MAX_TOTAL_EVS;
+}
+
+static bool32 SidedexDynamicRequestValid(void)
+{
+    u32 i;
+    bool32 playerMoveFound = FALSE, mainSeedPresent;
+    const volatile struct SidedexDynamicRequest *request = &gSidedexDynamicRequest;
+
+    if (request->magic != SIDEDEX_DYNAMIC_MAGIC
+     || request->version != SIDEDEX_DYNAMIC_VERSION
+     || request->status != SIDEDEX_DYNAMIC_SUBMITTED
+     || request->playerCount == 0 || request->playerCount > SIDEDEX_DYNAMIC_PARTY_LIMIT
+     || request->opponentCount == 0 || request->opponentCount > SIDEDEX_DYNAMIC_PARTY_LIMIT
+     || request->replayCount > 1
+     || request->candidateKind > SIDEDEX_DYNAMIC_SWITCH)
+        return FALSE;
+    for (i = 0; i < request->playerCount; i++)
+        if (!SidedexDynamicMonValid(&request->player[i]))
+            return FALSE;
+    for (i = 0; i < request->opponentCount; i++)
+        if (!SidedexDynamicMonValid(&request->opponent[i]))
+            return FALSE;
+    if (request->candidateKind == SIDEDEX_DYNAMIC_MOVE)
+    {
+        for (i = 0; i < MAX_MON_MOVES; i++)
+            if (request->player[0].moves[i] == request->playerMove)
+                playerMoveFound = TRUE;
+        if (!playerMoveFound)
+            return FALSE;
+    }
+    else if (request->playerSlot == 0 || request->playerSlot >= request->playerCount)
+        return FALSE;
+
+    if (request->secondPresent)
+    {
+        u32 active = request->candidateKind == SIDEDEX_DYNAMIC_SWITCH ? request->playerSlot : 0;
+        bool32 secondMoveFound = FALSE;
+
+        if (request->secondKind > SIDEDEX_DYNAMIC_SWITCH)
+            return FALSE;
+        if (request->secondKind == SIDEDEX_DYNAMIC_SWITCH)
+        {
+            if (request->secondSlot == 0 || request->secondSlot >= request->playerCount)
+                return FALSE;
+        }
+        else
+        {
+            for (i = 0; i < MAX_MON_MOVES; i++)
+                if (request->player[active].moves[i] == request->secondMove)
+                    secondMoveFound = TRUE;
+            if (!secondMoveFound)
+                return FALSE;
+        }
+    }
+
+    if (request->replayCount)
+    {
+        const volatile struct SidedexDynamicTurn *turn = &request->replay;
+        if (turn->playerKind > SIDEDEX_DYNAMIC_SWITCH || turn->opponentKind > SIDEDEX_DYNAMIC_SWITCH)
+            return FALSE;
+        if ((turn->playerKind == SIDEDEX_DYNAMIC_MOVE && turn->playerMove == MOVE_NONE)
+         || (turn->playerKind == SIDEDEX_DYNAMIC_SWITCH && (turn->playerSlot == 0 || turn->playerSlot >= request->playerCount))
+         || (turn->opponentKind == SIDEDEX_DYNAMIC_MOVE && turn->opponentMove == MOVE_NONE)
+         || (turn->opponentKind == SIDEDEX_DYNAMIC_SWITCH && (turn->opponentSlot == 0 || turn->opponentSlot >= request->opponentCount)))
+            return FALSE;
+    }
+    mainSeedPresent = request->mainRng.a | request->mainRng.b
+                    | request->mainRng.c | request->mainRng.ctr;
+    return mainSeedPresent;
+}
