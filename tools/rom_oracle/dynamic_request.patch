+void TestRunner_Battle_BudgetExceeded(u32 instructions)
+{
+    Test_MgbaPrintf("ROMTRACE|instruction-budget-exceeded|%u", instructions);
+}
+
+// Logic-only mode runs up to this many synchronous state advances per frame.
+// Normal mode is exactly one, so it stays the differential baseline.
+u32 TestRunner_Battle_LogicPumpIterations(void)
+{
+    if (!SidedexDynamicLogicOnly())
+        return 1;
+    return 4;
+}
+
+// TRUE stops the pump for this frame: boundary hold, terminal, or budget.
+bool32 TestRunner_Battle_LogicPumpYield(void)
+{
+    if (!SidedexDynamicLogicOnly())
+        return TRUE;
+    sSidedexInstructions++;
+    if (sSidedexInstructions > 2000000)
+    {
+        if (!sSidedexBudgetReported)
+        {
+            sSidedexBudgetReported = TRUE;
+            TestRunner_Battle_BudgetExceeded(sSidedexInstructions);
+        }
+        return TRUE;
+    }
+    if (sSidedexBoundaryHold || gBattleOutcome != 0 || NoAliveMonsForEitherParty())
+        return TRUE;
+    return FALSE;
+}
+
+// Release condition: a submitted request with a different requestId than the
+// one that created the hold. On release the action is latched for injection.
+static bool32 SidedexBoundaryWait(void)
+{
+    if (gSidedexDynamicRequest.status == SIDEDEX_DYNAMIC_SUBMITTED
+     && gSidedexDynamicRequest.requestId != sSidedexHoldRequestId)
+    {
+        sSidedexBoundaryHold = FALSE;
+        gSidedexDynamicRequest.status = SIDEDEX_DYNAMIC_RUNNING;
+        sSidedexInjectKind = gSidedexDynamicRequest.candidateKind;
+        sSidedexInjectMove = gSidedexDynamicRequest.playerMove;
+        sSidedexInjectSlot = gSidedexDynamicRequest.playerSlot;
+        sSidedexInjectMoveSlot = 0;
+        sSidedexInjectPending = TRUE;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+bool32 TestRunner_Battle_HoldAtBoundary(u32 battler, bool32 turnStart)
+{
+    if (!SidedexDynamicSimulate()
+     || battler != GetBattlerAtPosition(B_POSITION_PLAYER_LEFT))
+        return FALSE;
+    if (!sSidedexBoundaryHold)
+    {
+        u32 turn;
+        if (!turnStart)
+            return FALSE;
+        // Replay turns are root construction; do not hold at their boundary.
+        if (gBattleResults.battleTurnCounter < gSidedexDynamicRequest.replayCount)
+            return FALSE;
+        turn = gBattleResults.battleTurnCounter;
+        // Wire-contract ordering: the boundary marker must be the LAST record of
+        // the boundary emission. The worker's batch stop treats
+        // ROMTRACE|boundary| as "this turn's evidence is complete", so emitting
+        // it before the state export truncates the export. Keep it last.
+        SidedexEmitLegalActions(battler, turn, FALSE);
+        SidedexEmitDecisionState(turn);
+        Test_MgbaPrintf("ROMTRACE|boundary|player-choice|%d|%d", turn,
+                        SidedexLegalActionCount(battler));
+        Test_MgbaPrintf("ROMTRACE|phase|%d|boundary|player-choice|%d", turn,
+                        SidedexLegalActionCount(battler));
+        sSidedexBoundaryHold = TRUE;
+        sSidedexHoldRequestId = gSidedexDynamicRequest.requestId;
+    }
+    return SidedexBoundaryWait();
+}
+
+// Forced switch after a faint: the machine is inside the faint handler, so this
+// emits the boundary and holds the controller until a request arrives.
+bool32 TestRunner_Battle_HoldAtForcedSwitch(u32 battler)
+{
+    if (!SidedexDynamicSimulate()
+     || battler != GetBattlerAtPosition(B_POSITION_PLAYER_LEFT))
+        return FALSE;
+    if (!sSidedexBoundaryHold)
+    {
+        u32 turn = gBattleResults.battleTurnCounter;
+        // Marker last, as above.
+        SidedexEmitLegalActions(battler, turn, TRUE);
+        SidedexEmitDecisionState(turn);
+        Test_MgbaPrintf("ROMTRACE|boundary|forced-switch-player|%d|%d", turn,
+                        SidedexLegalActionCount(battler));
+        Test_MgbaPrintf("ROMTRACE|phase|%d|boundary|forced-switch-player|%d", turn,
+                        SidedexLegalActionCount(battler));
+        sSidedexBoundaryHold = TRUE;
+        sSidedexHoldRequestId = gSidedexDynamicRequest.requestId;
+    }
+    return SidedexBoundaryWait();
+}
