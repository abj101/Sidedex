+            Test_MgbaPrintf("ROMTRACE|legal|switch|%d|%d", i,
+                            GetMonData(&gPlayerParty[i], MON_DATA_SPECIES, NULL));
+            Test_MgbaPrintf("ROMTRACE|phase|%d|legal|switch|%d|%d", turn, i,
+                            GetMonData(&gPlayerParty[i], MON_DATA_SPECIES, NULL));
+        }
+    }
+}
+
+// Legal player actions at the boundary, enumerated from the ROM (contract 2.2
+// rule 4). Forced switch (active fainted) offers switches only.
+static u32 SidedexLegalActionCount(u32 battler)
+{
+    u32 i, count = 0;
+    u32 activeSlot = gBattleStruct->battlerPartyIndexes[battler];
+    if (gBattleMons[battler].hp == 0)
+    {
+        for (i = 0; i < gSidedexDynamicRequest.playerCount; i++)
+            if (i != activeSlot && GetMonData(&gPlayerParty[i], MON_DATA_HP, NULL) != 0)
+                count++;
+        return count;
+    }
+    for (i = 0; i < MAX_MON_MOVES; i++)
+        if (gBattleMons[battler].moves[i] != MOVE_NONE && gBattleMons[battler].pp[i] != 0)
+            count++;
+    if (CanBattlerEscape(battler))
+    {
+        for (i = 0; i < gSidedexDynamicRequest.playerCount; i++)
+            if (i != activeSlot && GetMonData(&gPlayerParty[i], MON_DATA_HP, NULL) != 0)
+                count++;
+    }
+    return count;
+}
+
+u32 TestRunner_Battle_LegalPlayerActionCount(void)
+{
+    return SidedexLegalActionCount(GetBattlerAtPosition(B_POSITION_PLAYER_LEFT));
+}
