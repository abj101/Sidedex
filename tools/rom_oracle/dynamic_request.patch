+bool32 TestRunner_Battle_HoldAtBoundary(u32 battler, bool32 turnStart)
+{
+    if (!SidedexDynamicSimulate()
+     || battler != GetBattlerAtPosition(B_POSITION_PLAYER_LEFT))
+        return FALSE;
+    if (!sSidedexBoundaryHold)
+    {
+        u32 turn;
+        if (!turnStart)
+            return FALSE;
+        // Replay turns are root construction; do not hold at their boundary.
+        if (gBattleResults.battleTurnCounter < gSidedexDynamicRequest.replayCount)
+            return FALSE;
+        turn = gBattleResults.battleTurnCounter;
+        SidedexCommitBoundary(turn, SIDEDEX_BOUNDARY_CHOICE, FALSE, "player-choice");
+        sSidedexBoundaryHold = TRUE;
+        sSidedexHoldRequestId = gSidedexDynamicRequest.requestId;
+    }
+    return SidedexBoundaryWait();
+}
