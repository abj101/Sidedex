+enum
+{
+    SIDEDEX_QUERY_UNSUPPORTED = 1 << 0,
+    SIDEDEX_QUERY_MULTI_HIT_RANGE = 1 << 3,
+};
+
+static bool32 sSidedexQueryRngActive;
+static enum RandomTag sSidedexQueryRngTag;
+static u32 sSidedexQueryRngValue;
+
+static s32 SidedexQueryDamage(u32 battlerAtk, u32 battlerDef, u32 move, bool32 critical, u32 roll)
+{
+    struct DamageCalculationData damageCalcData = {
+        .battlerAtk = battlerAtk,
+        .battlerDef = battlerDef,
+        .move = move,
+        .moveType = GetMoveType(move),
+        .isCrit = critical,
+        .randomFactor = TRUE,
+        .updateFlags = FALSE,
+    };
+    s32 damage;
+    u32 abilityDef = GetBattlerAbility(battlerDef);
+    bool32 aiCalc = AI_DATA->aiCalcInProgress;
+
+    // Soundproof, Volt Absorb, Flash Fire, ... stop the move before damage
+    // (ABILITYEFFECT_MOVES_BLOCK / ABSORBING), outside CalculateMoveDamage.
+    // aiCalcInProgress makes Dazzling read the move priority, not the chosen action.
+    AI_DATA->aiCalcInProgress = TRUE;
+    damage = CanAbilityBlockMove(battlerAtk, battlerDef, move, abilityDef)
+          || CanAbilityAbsorbMove(battlerAtk, battlerDef, abilityDef, move, damageCalcData.moveType);
+    AI_DATA->aiCalcInProgress = aiCalc;
+    if (damage || DoesDisguiseBlockMove(battlerDef, move)
+     || (abilityDef == ABILITY_ICE_FACE && IS_MOVE_PHYSICAL(move) && gBattleMons[battlerDef].species == SPECIES_EISCUE))
+        return 0;
+
+    // Fixed-damage moves set gBattleMoveDamage in their own script command
+    // (dmgtolevel, psywavedamageeffect, ...) after typecalc, not in CalculateMoveDamage.
+    switch (gMovesInfo[move].effect)
+    {
+    case EFFECT_LEVEL_DAMAGE:
+    case EFFECT_PSYWAVE:
+    case EFFECT_FIXED_DAMAGE_ARG:
+    case EFFECT_SUPER_FANG:
+    case EFFECT_ENDEAVOR:
+    case EFFECT_FINAL_GAMBIT:
+        if (CalcTypeEffectivenessMultiplier(move, damageCalcData.moveType, battlerAtk, battlerDef, abilityDef, FALSE) == UQ_4_12(0.0))
+            return 0;
+        switch (gMovesInfo[move].effect)
+        {
+        case EFFECT_LEVEL_DAMAGE:
+            return gBattleMons[battlerAtk].level;
+        case EFFECT_PSYWAVE: // Cmd_psywavedamageeffect: level * (50..150)%; roll 0 is the high end
+            return gBattleMons[battlerAtk].level * (50 + 100 * (15 - roll) / 15) / 100;
+        case EFFECT_FIXED_DAMAGE_ARG:
+            return gMovesInfo[move].argument;
+        case EFFECT_SUPER_FANG:
+            return max(1, GetNonDynamaxHP(battlerDef) / 2);
+        case EFFECT_ENDEAVOR:
+            return max(0, (s32)gBattleMons[battlerDef].hp - (s32)gBattleMons[battlerAtk].hp);
+        default: // EFFECT_FINAL_GAMBIT
+            return gBattleMons[battlerAtk].hp;
+        }
+    }
+
+    sSidedexQueryRngActive = TRUE;
+    sSidedexQueryRngTag = RNG_DAMAGE_MODIFIER;
+    sSidedexQueryRngValue = roll;
+    damage = CalculateMoveDamage(&damageCalcData, 0);
+    sSidedexQueryRngActive = FALSE;
+    return max(0, damage);
+}
+
+// Total damage of `hits` hits, each at its lowest (best FALSE) or highest roll,
+// with the per-hit state the battle script sets: gMultiHitCounter (Triple Kick
+// power), beatUpSlot, the Parental Bond / OraOraOraOra second hit. Hits land in
+// order, so the target's HP (Multiscale, Super Fang), a broken Disguise or Ice
+// Face, and Stamina / Weak Armor / Water Compaction apply to the later hits.
+static u32 SidedexQueryHits(u32 battlerAtk, u32 battlerDef, u32 move, u32 hits, bool32 best,
+                            u32 nonCritWeight, u32 critWeight)
+{
+    struct BattlePokemon savedDef = gBattleMons[battlerDef];
+    u32 savedCounter = gMultiHitCounter, savedSlot = gBattleStruct->beatUpSlot;
+    u32 savedBond = gSpecialStatuses[battlerAtk].parentalBondState;
+    u32 savedOra = gSpecialStatuses[battlerAtk].oraoraoraoraState;
+    struct Pokemon *party = GetBattlerParty(battlerAtk);
+    bool32 crit = best ? critWeight != 0 : nonCritWeight == 0;
+    u32 abilityAtk = GetBattlerAbility(battlerAtk);
+    u32 hit, slot = 0, total = 0;
+
+    for (hit = 0; hit < hits; hit++)
+    {
+        u32 damage, abilityDef = GetBattlerAbility(battlerDef);
+        bool32 blocked = DoesDisguiseBlockMove(battlerDef, move)
+                      || (abilityDef == ABILITY_ICE_FACE && IS_MOVE_PHYSICAL(move)
+                       && gBattleMons[battlerDef].species == SPECIES_EISCUE);
+
+        gMultiHitCounter = hits - hit;
+        if (gMovesInfo[move].effect == EFFECT_BEAT_UP)
+        {
+            while (slot < PARTY_SIZE && !(GetMonData(&party[slot], MON_DATA_HP)
+                   && GetMonData(&party[slot], MON_DATA_SPECIES) != SPECIES_NONE
+                   && !GetMonData(&party[slot], MON_DATA_IS_EGG)
+                   && !GetMonData(&party[slot], MON_DATA_STATUS)))
+                slot++;
+            gBattleStruct->beatUpSlot = slot++;
+        }
+        if (hits == 2 && abilityAtk == ABILITY_PARENTAL_BOND)
+            gSpecialStatuses[battlerAtk].parentalBondState = hit ? PARENTAL_BOND_2ND_HIT : PARENTAL_BOND_1ST_HIT;
+        if (hits == 2 && abilityAtk == ABILITY_ORAORAORAORA)
+            gSpecialStatuses[battlerAtk].oraoraoraoraState = hit ? ORAORAORAORA_2ND_HIT : ORAORAORAORA_1ST_HIT;
+        damage = SidedexQueryDamage(battlerAtk, battlerDef, move, crit, best ? 0 : 15);
+        total += damage;
+        if (blocked)
+            gBattleMons[battlerDef].species = gBattleMons[battlerDef].species == SPECIES_EISCUE
+                                            ? SPECIES_EISCUE_NOICE : SPECIES_MIMIKYU_BUSTED;
+        gBattleMons[battlerDef].hp = total < savedDef.hp ? savedDef.hp - total : 1;
+        if (damage)
+        {
+            s32 stage = gBattleMons[battlerDef].statStages[STAT_DEF];
+            if (abilityDef == ABILITY_STAMINA)
+                stage += 1;
+            else if (abilityDef == ABILITY_WEAK_ARMOR && IS_MOVE_PHYSICAL(move))
+                stage -= 1;
+            else if (abilityDef == ABILITY_WATER_COMPACTION && GetMoveType(move) == TYPE_WATER)
+                stage += 2;
+            gBattleMons[battlerDef].statStages[STAT_DEF] = max(MIN_STAT_STAGE, min(MAX_STAT_STAGE, stage));
+        }
+    }
+    gBattleMons[battlerDef] = savedDef;
+    gMultiHitCounter = savedCounter;
+    gBattleStruct->beatUpSlot = savedSlot;
+    gSpecialStatuses[battlerAtk].parentalBondState = savedBond;
+    gSpecialStatuses[battlerAtk].oraoraoraoraState = savedOra;
+    return total;
+}
+
+static void SidedexQueryMove(u32 owner, u32 battlerAtk, u32 battlerDef, u32 move)
+{
+    u32 abilityAtk = GetBattlerAbility(battlerAtk);
+    u32 abilityDef = GetBattlerAbility(battlerDef);
+    u32 holdEffectAtk = GetBattlerHoldEffect(battlerAtk, TRUE);
+    u32 holdEffectDef = GetBattlerHoldEffect(battlerDef, TRUE);
+    u32 oldAttacker = gBattlerAttacker, oldTarget = gBattlerTarget;
+    u32 oldMove = gCurrentMove;
+    u32 flags = 0, roll, critDen = 1, accuracy;
+    u32 minHits = 1, maxHits = 1;
+    u32 minimum = UINT_MAX, maximum = 0, nonCritWeight, critWeight;
+    s32 critChance, ordinaryCritChance;
+    struct BattlePokemon savedAtk;
+    struct Pokemon savedAtkMon;
+    u16 savedChangedSpecies;
+
+    // Hit counts as CANCELLER_MULTIHIT_MOVES and Cmd_attackcanceler set them.
+    if (gMovesInfo[move].effect == EFFECT_MULTI_HIT)
+    {
+        minHits = 2;
+        maxHits = 5;
+        if (abilityAtk == ABILITY_SKILL_LINK)
+            minHits = 5;
+        else if (abilityAtk == ABILITY_BATTLE_BOND && move == MOVE_WATER_SHURIKEN
+              && gBattleMons[battlerAtk].species == SPECIES_GRENINJA_ASH)
+            minHits = maxHits = 3;
+        else if (holdEffectAtk == HOLD_EFFECT_LOADED_DICE)
+            minHits = 4;
+    }
+    else if (gMovesInfo[move].strikeCount > 1)
+    {
+        minHits = maxHits = gMovesInfo[move].strikeCount;
+        if (gMovesInfo[move].effect == EFFECT_POPULATION_BOMB && holdEffectAtk == HOLD_EFFECT_LOADED_DICE)
+            minHits = 4;
+    }
+    else if (B_BEAT_UP >= GEN_5 && gMovesInfo[move].effect == EFFECT_BEAT_UP)
+    {
+        struct Pokemon *party = GetBattlerParty(battlerAtk);
+        u32 i;
+        minHits = 0;
+        for (i = 0; i < PARTY_SIZE; i++)
+            if (GetMonData(&party[i], MON_DATA_HP) && GetMonData(&party[i], MON_DATA_SPECIES) != SPECIES_NONE
+             && !GetMonData(&party[i], MON_DATA_IS_EGG) && !GetMonData(&party[i], MON_DATA_STATUS))
+                minHits++;
+        maxHits = minHits;
+    }
+    else if ((abilityAtk == ABILITY_PARENTAL_BOND && IsMoveAffectedByParentalBond(move, battlerAtk))
+          || (abilityAtk == ABILITY_ORAORAORAORA && gMovesInfo[move].punchingMove))
+    {
+        minHits = maxHits = 2;
+    }
+    if (maxHits > 1)
+        flags |= SIDEDEX_QUERY_MULTI_HIT_RANGE;
+    switch (gMovesInfo[move].effect)
+    {
+    case EFFECT_COUNTER: case EFFECT_MIRROR_COAT: case EFFECT_METAL_BURST: case EFFECT_BIDE:
+        flags |= SIDEDEX_QUERY_UNSUPPORTED; // Damage depends on the hit taken this turn.
+        break;
+    case EFFECT_LEVEL_DAMAGE: case EFFECT_PSYWAVE: case EFFECT_FIXED_DAMAGE_ARG:
+    case EFFECT_SUPER_FANG: case EFFECT_ENDEAVOR: case EFFECT_FINAL_GAMBIT: case EFFECT_BEAT_UP:
+        break;
+    default:
+        if (gMovesInfo[move].category != DAMAGE_CATEGORY_STATUS && gMovesInfo[move].power == 0)
+            flags |= SIDEDEX_QUERY_UNSUPPORTED;
+        break;
+    }
+
+    if (flags & SIDEDEX_QUERY_UNSUPPORTED)
+    {
+        Test_MgbaPrintf("ROMTRACE|query|damage|%d|%d|0|0|%d|0|0|0|0",
+                        owner, move, flags);
+        return;
+    }
+    if (gMovesInfo[move].category == DAMAGE_CATEGORY_STATUS)
+    {
+        Test_MgbaPrintf("ROMTRACE|query|damage|%d|%d|0|0|0|0|0|0|1", owner, move);
+        return;
+    }
+
+    gBattlerAttacker = battlerAtk;
+    gBattlerTarget = battlerDef;
+    gCurrentMove = move;
+    // GetMoveType reads dynamicMoveType whenever it is set, so type each move
+    // (Weather Ball, -ate abilities, ...) and clear it after, like the AI calc.
+    SetTypeBeforeUsingMove(move, battlerAtk);
+    // Attacker changes the battle script makes before the hit; undone at the end.
+    savedAtk = gBattleMons[battlerAtk];
+    savedAtkMon = GetBattlerParty(battlerAtk)[gBattlerPartyIndexes[battlerAtk]];
+    savedChangedSpecies = gBattleStruct->changedSpecies[GetBattlerSide(battlerAtk)][gBattlerPartyIndexes[battlerAtk]];
+    ProteanTryChangeType(battlerAtk, abilityAtk, move, GetMoveType(move));
+    if (!TryBattleFormChange(battlerAtk, FORM_CHANGE_BATTLE_BEFORE_MOVE))
+        TryBattleFormChange(battlerAtk, FORM_CHANGE_BATTLE_BEFORE_MOVE_CATEGORY);
+    accuracy = min(100, GetTotalAccuracy(battlerAtk, battlerDef, move,
+                                         abilityAtk, abilityDef,
+                                         holdEffectAtk, holdEffectDef));
+    // AccuracyCalcHelper's sure-hit rules; it jumps the battle script, so it can't be called here.
+    if (abilityAtk == ABILITY_NO_GUARD || abilityDef == ABILITY_NO_GUARD
+     || gMovesInfo[move].accuracy == 0
+     || (gStatuses3[battlerDef] & STATUS3_ALWAYS_HITS && gDisableStructs[battlerDef].battlerWithSureHit == battlerAtk)
+     || gStatuses4[battlerDef] & STATUS4_GLAIVE_RUSH
+     || (abilityAtk == ABILITY_FATAL_PRECISION
+      && CalcTypeEffectivenessMultiplier(move, gMovesInfo[move].type, battlerAtk, battlerDef, ABILITY_FATAL_PRECISION, FALSE) >= UQ_4_12(2.0))
+     || (gStatuses3[battlerDef] & STATUS3_TELEKINESIS && gMovesInfo[move].effect != EFFECT_OHKO)
+     || (B_MINIMIZE_DMG_ACC >= GEN_6 && gStatuses3[battlerDef] & STATUS3_MINIMIZED && gMovesInfo[move].minimizeDoubleDamage)
+     || (WEATHER_HAS_EFFECT && gBattleWeather & (B_WEATHER_HAIL | B_WEATHER_SNOW) && gMovesInfo[move].effect == EFFECT_BLIZZARD))
+        accuracy = 100;
+    critChance = CalcCritChanceStage(battlerAtk, battlerDef, move, FALSE,
+                                     abilityAtk, abilityDef, holdEffectAtk);
+    if (gSidedexDynamicRequest.criticalPolicy == SIDEDEX_DYNAMIC_CRIT_ITEM_ABILITY_ONLY)
+    {
+        ordinaryCritChance = CalcCritChanceStage(battlerAtk, battlerDef, move, FALSE,
+                                                 ABILITY_NONE, ABILITY_NONE, HOLD_EFFECT_NONE);
+        // Ordinary crit odds (including high-crit moves and Laser Focus) are not
+        // part of the item-ability-only policy. Retain crit only when an enabled
+        // ability or held item changes the engine's crit state. The `normal`
+        // policy keeps the real engine roll weights (parity mode).
+        if (critChance == ordinaryCritChance)
+            critChance = CRITICAL_HIT_BLOCKED;
+    }
+    if (critChance >= 0)
+        critDen = GetCritHitOdds(critChance);
+    nonCritWeight = critChance == CRITICAL_HIT_ALWAYS ? 0
+                  : critChance == CRITICAL_HIT_BLOCKED ? 1 : critDen - 1;
+    critWeight = critChance == CRITICAL_HIT_ALWAYS ? 1
+               : critChance == CRITICAL_HIT_BLOCKED ? 0 : 1;
+
+    if (flags & SIDEDEX_QUERY_MULTI_HIT_RANGE)
+    {
+        // Every hit is computed with its own state.
+        minimum = SidedexQueryHits(battlerAtk, battlerDef, move, minHits, FALSE, nonCritWeight, critWeight);
+        maximum = SidedexQueryHits(battlerAtk, battlerDef, move, maxHits, TRUE, nonCritWeight, critWeight);
+        Test_MgbaPrintf("ROMTRACE|query|damage|%d|%d|0|0|%d|%d|%d|%d|%d",
+                        owner, move, flags, minimum, maximum, accuracy, critDen);
+        goto restore;
+    }
+
+    for (roll = 0; roll < 16; roll++)
+    {
+        u32 damage;
+        if (nonCritWeight)
+        {
+            damage = SidedexQueryDamage(battlerAtk, battlerDef, move, FALSE, roll);
+            minimum = min(minimum, damage);
+            maximum = max(maximum, damage);
+        }
+        if (critWeight)
+        {
+            damage = SidedexQueryDamage(battlerAtk, battlerDef, move, TRUE, roll);
+            minimum = min(minimum, damage);
+            maximum = max(maximum, damage);
+        }
+    }
+
+    if (minimum == UINT_MAX)
+        minimum = 0;
+    // num/den (cells 5-6) are reserved and always 0.
+    Test_MgbaPrintf("ROMTRACE|query|damage|%d|%d|0|0|%d|%d|%d|%d|%d",
+                    owner, move, flags, minimum, maximum, accuracy, critDen);
+restore:
+    gBattleMons[battlerAtk] = savedAtk;
+    GetBattlerParty(battlerAtk)[gBattlerPartyIndexes[battlerAtk]] = savedAtkMon;
+    gBattleStruct->changedSpecies[GetBattlerSide(battlerAtk)][gBattlerPartyIndexes[battlerAtk]] = savedChangedSpecies;
+    gBattleStruct->dynamicMoveType = 0;
+    gBattlerAttacker = oldAttacker;
+    gBattlerTarget = oldTarget;
+    gCurrentMove = oldMove;
+}
+
+static u32 SidedexDynamicPartySlot(u32 battler)
+{
+    const volatile struct SidedexDynamicMon *party;
+    u32 count, i, j;
+    struct BattlePokemon *active = &gBattleMons[battler];
+    if (GetBattlerSide(battler) == B_SIDE_PLAYER)
+    {
+        party = gSidedexDynamicRequest.player;
+        count = gSidedexDynamicRequest.playerCount;
+    }
+    else
+    {
+        party = gSidedexDynamicRequest.opponent;
+        count = gSidedexDynamicRequest.opponentCount;
+    }
+    for (i = 0; i < count; i++)
+    {
+        if (party[i].species != active->species || party[i].ability != active->ability)
+            continue;
+        for (j = 0; j < MAX_MON_MOVES; j++)
+            if (party[i].moves[j] != active->moves[j])
+                break;
+        if (j == MAX_MON_MOVES)
+            return i;
+    }
+    return gBattlerPartyIndexes[battler];
+}
+
+bool32 TestRunner_Battle_RunQuery(u32 battlerId)
+{
+    u32 moveSlot;
+
+    if (!SidedexDynamicTraceActive()
+     || !SidedexDynamicQuery()
+     || GetBattlerSide(battlerId) != B_SIDE_OPPONENT
+     || gBattleResults.battleTurnCounter < gSidedexDynamicRequest.replayCount)
+        return FALSE;
+
+    Test_MgbaPrintf("ROMTRACE|critical-policy|%s|%s",
+                    SidedexCriticalPolicyLabel(), SidedexCriticalPolicyMechanism());
+    Test_MgbaPrintf("ROMTRACE|query|context|%s",
+                    gSidedexDynamicRequest.replayCount
+                     && gSidedexDynamicRequest.replay.playerKind == SIDEDEX_DYNAMIC_SWITCH
+                        ? "post-switch" : "current-state");
+    // The query is taken at the same pre-choice decision point as a boundary,
+    // so the ROM-derived legal player actions are reported here too.
+    {
+        u32 legalBuf[SIDEDEX_MAX_LEGAL * SIDEDEX_LEGAL_WORDS];
+        sSidedexCompact = (gSidedexDynamicRequest.flags & 1) != 0;
+        SidedexBuildLegal(GetBattlerAtPosition(B_POSITION_PLAYER_LEFT),
+                          FALSE, gBattleResults.battleTurnCounter, legalBuf);
+    }
+    for (moveSlot = 0; moveSlot < gBattlersCount; moveSlot++)
+    {
+        u32 side = GetBattlerSide(moveSlot);
+        u32 slot = SidedexDynamicPartySlot(moveSlot);
+        struct BattlePokemon *mon = &gBattleMons[moveSlot];
+        u32 m;
+        Test_MgbaPrintf("ROMTRACE|query|active|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d",
+                        side, slot, mon->species, mon->hp, mon->maxHP,
+                        mon->statStages[STAT_ATK], mon->statStages[STAT_DEF],
+                        mon->statStages[STAT_SPEED], mon->statStages[STAT_SPATK],
+                        mon->statStages[STAT_SPDEF], mon->statStages[STAT_ACC],
+                        mon->statStages[STAT_EVASION]);
+        for (m = 0; m < MAX_MON_MOVES; m++)
+            Test_MgbaPrintf("ROMTRACE|query|active-move|%d|%d|%d", side, m, mon->moves[m]);
+    }
+    for (moveSlot = 0; moveSlot < MAX_MON_MOVES; moveSlot++)
+    {
+        u32 move = gBattleMons[B_POSITION_PLAYER_LEFT].moves[moveSlot];
+        if (move != MOVE_NONE)
+            SidedexQueryMove(B_SIDE_PLAYER, B_POSITION_PLAYER_LEFT,
+                             B_POSITION_OPPONENT_LEFT, move);
+    }
+    for (moveSlot = 0; moveSlot < MAX_MON_MOVES; moveSlot++)
+    {
+        u32 move = gBattleMons[B_POSITION_OPPONENT_LEFT].moves[moveSlot];
+        if (move != MOVE_NONE)
+            SidedexQueryMove(B_SIDE_OPPONENT, B_POSITION_OPPONENT_LEFT,
+                             B_POSITION_PLAYER_LEFT, move);
+    }
+
+    AI_TrySwitchOrUseItem(battlerId);
+    u8 action = gBattleResources->bufferB[battlerId][1];
+    if (action == B_ACTION_USE_ITEM)
+        Test_MgbaPrintf("ROMTRACE|query|ai|item|%d", gBattleStruct->chosenItem[battlerId]);
+    else if (action == B_ACTION_SWITCH)
+        Test_MgbaPrintf("ROMTRACE|query|ai|switch|%d",
+                        gBattleStruct->monToSwitchIntoId[battlerId]);
+    else
+    {
+        moveSlot = gBattleStruct->aiMoveOrAction[battlerId];
+        Test_MgbaPrintf("ROMTRACE|query|ai|move|%d",
+                        gBattleMons[battlerId].moves[moveSlot]);
+    }
+    gSidedexDynamicRequest.status = SIDEDEX_DYNAMIC_COMPLETE;
+    Test_MgbaPrintf("ROMTRACE|query|complete");
+    Test_MgbaPrintf("ROMTRACE|complete|0");
+    return TRUE;
+}
