+    Test_MgbaPrintf("ROMTRACE|unrepresentable|trainer-item-decision");
+    Test_MgbaPrintf("ROMTRACE|phase|%d|unrepresentable|trainer-item-decision",
+                    gBattleResults.battleTurnCounter);
+    Test_MgbaPrintf("ROMTRACE|phase|%d|item-refused|%d|%d",
+                    gBattleResults.battleTurnCounter, battler, item);
+}
+
+void TestRunner_Battle_ApplyTrainerItems(void)
+{
+    u32 i;
+    // Trainer items are copied into the battle history for BOTH the pre-choice
+    // query turn and a resolved SIMULATE_TURN, so the AI makes the real item
+    // decision in either case. A resolved turn cannot *execute* the item: in a
+    // trainer battle outside easy mode the ROM ruleset refuses
+    // B_ACTION_USE_ITEM (src/battle_main.c), and the AI then falls back to a
+    // move. That divergence is reported by TestRunner_Battle_RejectTrainerItem
+    // as `ROMTRACE|unrepresentable|trainer-item-decision` and the turn
+    // completes; it never stalls. (The v8 stall was a separate base-code bug:
+    // RecordedBattle_ClearBattlerAction underflowed the u16 record cursor for a
+    // battler with no recorded actions and wrote sBattleRecords[battler][65535],
+    // corrupting EWRAM. Fixed in src/recorded_battle.c.)
+    if (!SidedexDynamicTraceActive()
+     || gSidedexDynamicRequest.version != SIDEDEX_DYNAMIC_VERSION
+     || gSidedexDynamicRequest.trainerItemCount == 0)
+        return;
+    for (i = 0; i < MAX_TRAINER_ITEMS; i++)
+        gBattleResources->battleHistory->trainerItems[i] =
+            (i < gSidedexDynamicRequest.trainerItemCount)
+                ? gSidedexDynamicRequest.trainerItems[i] : ITEM_NONE;
+    gBattleResources->battleHistory->itemsNo = gSidedexDynamicRequest.trainerItemCount;
+}
