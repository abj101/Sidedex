+void TestRunner_Battle_TraceSwitchSettled(u32 battlerId)
+{
+    if (!SidedexOracleTraceActive())
+        return;
+    Test_MgbaPrintf("ROMTRACE|switch-settled|%d|%d|%d|%d", gBattleResults.battleTurnCounter, battlerId,
+                    gBattlerPartyIndexes[battlerId], gBattleMons[battlerId].species);
+    SidedexOracleTraceSnapshot("switch-settled");
+    if (SidedexDynamicTraceActive())
+    {
+        // Both sides settle here (Cmd_getswitchedmondata), which is the only point
+        // where the incoming slot and species are both final: tag 9 kind 7 is
+        // recorded just before the slot swap, so the ring reads 7 then 8.
+        u32 payload[3];
+        payload[0] = battlerId;
+        payload[1] = gBattlerPartyIndexes[battlerId];
+        payload[2] = gBattleMons[battlerId].species;
+        SidedexRecordEvent(8, payload, 3);
+    }
+}
