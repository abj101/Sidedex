+            switchType = SWITCH_MID_BATTLE;
+        chosenMonId = GetMostSuitableMonToSwitchInto(battler, switchType);
+        if (chosenMonId == PARTY_SIZE || !IsValidForBattle(&gPlayerParty[chosenMonId]))
