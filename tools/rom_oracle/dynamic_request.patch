+{
+    u32 crc = 0xFFFFFFFF, i, bit;
+    for (i = 0; i < length; i++)
+    {
+        crc ^= data[i];
+        for (bit = 0; bit < 8; bit++)
+            crc = (crc >> 1) ^ (0xEDB88320 & -(crc & 1));
+    }
+    return ~crc;
+}
+
+static u32 SidedexBufStr(char *out, const char *s)
+{
+    u32 n = 0;
+    while (s[n] != 0)
+    {
+        out[n] = s[n];
+        n++;
+    }
+    return n;
+}
+
+static u32 SidedexBufNum(char *out, u32 value)
+{
+    char digits[10];
+    u32 n = 0, i;
+    if (value == 0)
+    {
+        out[0] = '0';
+        return 1;
+    }
+    while (value > 0)
+    {
+        digits[n++] = '0' + (value % 10);
+        value /= 10;
+    }
+    for (i = 0; i < n; i++)
+        out[i] = digits[n - 1 - i];
+    return n;
+}
+
+// Mirror one tag's words to ROMTRACE in 16-word chunks. One chunk per line
+// keeps every record under the 255-byte debug-string flush boundary; the base
+// index makes the reassembly order explicit.
+static void SidedexTraceRecord(const char *name, u32 turn, u32 base, const u32 *words, u32 count)
+{
+    char line[260];
+    u32 chunk, i, n, len;
+    if (sSidedexCompact || gSidedexDynamicResult == NULL)
+        return;
+    for (chunk = 0; chunk < count; chunk += 16)
+    {
+        len = count - chunk;
+        if (len > 16)
+            len = 16;
+        n = SidedexBufStr(line, "ROMTRACE|phase|");
+        n += SidedexBufNum(line + n, turn);
+        n += SidedexBufStr(line + n, "|state|");
+        n += SidedexBufStr(line + n, name);
+        n += SidedexBufStr(line + n, "|");
+        n += SidedexBufNum(line + n, base + chunk);
+        for (i = 0; i < len; i++)
+        {
+            n += SidedexBufStr(line + n, "|");
+            n += SidedexBufNum(line + n, words[chunk + i]);
+        }
+        line[n] = 0;
+        Test_MgbaPrintf("%s", line);
+    }
+}
+
+static void SidedexResultBegin(void)
+{
+    u32 i;
+    if (gSidedexDynamicResult == NULL)
+        return;
+    for (i = 0; i < SIDEDEX_EVENT_SCRATCH; i++)
+        gSidedexDynamicResult[i] = 0;
+    sSidedexResultLen = 64;
+    sSidedexRecordCount = 0;
+    sSidedexCompact = (gSidedexDynamicRequest.flags & 1) != 0;
+}
+
+static void SidedexAppend16(u16 value)
+{
+    if (gSidedexDynamicResult == NULL)
+        return;
+    SidedexResultWrite16(sSidedexResultLen, value);
+    sSidedexResultLen += 2;
+}
+
+static void SidedexAppend32(u32 value)
+{
+    if (gSidedexDynamicResult == NULL)
+        return;
+    SidedexResultWrite32(sSidedexResultLen, value);
+    sSidedexResultLen += 4;
+}
+
+// Typed record header + payload (contract C.1/C.2). count*words*4 is a multiple
+// of four, so the record needs no padding.
+static void SidedexBeginTyped(u16 tag, u16 count, u16 words)
+{
+    SidedexAppend16(tag);
+    SidedexAppend16(4 + count * words * 4);
+    SidedexAppend16(count);
+    SidedexAppend16(words);
+    sSidedexRecordCount++;
+}
+
+static void SidedexAppendTyped(u16 tag, u16 count, u16 words, const u32 *data)
+{
+    u32 i, n = (u32)count * words;
+    SidedexBeginTyped(tag, count, words);
+    for (i = 0; i < n; i++)
+        SidedexAppend32(data[i]);
+}
+
+// Ordered mechanical events (tag 9, contract C.3). Captured from the same ROM
+// callbacks that feed the diagnostic trace; unknown kinds are never invented.
+static void SidedexRecordEvent(u16 kind, const u32 *payload, u16 words)
+{
+    u8 *slot;
+    u32 i;
+    if (!SidedexDynamicTraceActive()
+     || gSidedexDynamicResult == NULL
+     || sSidedexEventCount >= SIDEDEX_MAX_EVENTS
+     || words > 4)
+        return;
+    slot = gSidedexDynamicResult + SIDEDEX_EVENT_SCRATCH + sSidedexEventCount * SIDEDEX_EVENT_STRIDE;
+    slot[0] = kind;
+    slot[1] = kind >> 8;
+    slot[2] = words;
+    slot[3] = words >> 8;
+    for (i = 0; i < words; i++)
+    {
+        slot[4 + i * 4] = payload[i];
+        slot[5 + i * 4] = payload[i] >> 8;
+        slot[6 + i * 4] = payload[i] >> 16;
+        slot[7 + i * 4] = payload[i] >> 24;
+    }
+    sSidedexEventCount++;
+}
+
+static void SidedexResetEvents(void)
+{
+    u32 i;
+    sSidedexEventCount = 0;
+    for (i = 0; i < SIDEDEX_TRAINER_WORDS; i++)
+        sSidedexTrainerAction[i] = 0;
+}
+
+static void SidedexAppendEvents(void)
+{
+    u32 i, j, bytes = 0;
+    u8 *slot;
+    for (i = 0; i < sSidedexEventCount; i++)
+    {
+        slot = gSidedexDynamicResult + SIDEDEX_EVENT_SCRATCH + i * SIDEDEX_EVENT_STRIDE;
+        bytes += 4 + (slot[2] | (slot[3] << 8)) * 4;
+    }
+    SidedexAppend16(9);
+    SidedexAppend16(bytes);
+    for (i = 0; i < sSidedexEventCount; i++)
+    {
+        u16 words;
+        slot = gSidedexDynamicResult + SIDEDEX_EVENT_SCRATCH + i * SIDEDEX_EVENT_STRIDE;
+        words = slot[2] | (slot[3] << 8);
+        SidedexAppend16(slot[0] | (slot[1] << 8));
+        SidedexAppend16(words);
+        for (j = 0; j < words; j++)
+            SidedexAppend32(slot[4 + j * 4] | (slot[5 + j * 4] << 8)
+                          | (slot[6 + j * 4] << 16) | ((u32)slot[7 + j * 4] << 24));
+    }
+    sSidedexRecordCount++;
+}
+
+// volatile_flags: the DisableStruct one-bit persistent effect trackers, which
+// status1/status2/status3 do not carry. README "v9 flag words" documents each
+// bit against include/battle.h struct DisableStruct.
+static u32 SidedexPackVolatileFlags(u32 battler)
+{
+    const struct DisableStruct *d = &gDisableStructs[battler];
+    return (u32)d->truantCounter
+         | ((u32)d->truantSwitchInHack << 1)
+         | ((u32)d->noRetreat << 2)
+         | ((u32)d->tarShot << 3)
+         | ((u32)d->octolock << 4)
+         | ((u32)d->cudChew << 5)
+         | ((u32)d->spikesDone << 6)
+         | ((u32)d->toxicSpikesDone << 7)
+         | ((u32)d->stickyWebDone << 8)
+         | ((u32)d->stealthRockDone << 9)
+         | ((u32)d->syrupBombIsShiny << 10)
+         | ((u32)d->steelSurgeDone << 11)
+         | ((u32)d->weatherAbilityDone << 12)
+         | ((u32)d->terrainAbilityDone << 13)
+         | ((u32)d->usedProteanLibero << 14);
+}
+
+// protect_flags: the low 32-bit bitfield of struct ProtectStruct, in
+// declaration order (README "v9 flag words").
+static u32 SidedexPackProtectFlags(u32 battler)
+{
+    const struct ProtectStruct *p = &gProtectStructs[battler];
+    return (u32)p->protected
+         | ((u32)p->spikyShielded << 1)
+         | ((u32)p->kingsShielded << 2)
+         | ((u32)p->banefulBunkered << 3)
+         | ((u32)p->obstructed << 4)
+         | ((u32)p->endured << 5)
+         | ((u32)p->noValidMoves << 6)
+         | ((u32)p->helpingHand << 7)
+         | ((u32)p->bounceMove << 8)
+         | ((u32)p->stealMove << 9)
+         | ((u32)p->prlzImmobility << 10)
+         | ((u32)p->confusionSelfDmg << 11)
+         | ((u32)p->targetAffected << 12)
+         | ((u32)p->chargingTurn << 13)
+         | ((u32)p->fleeType << 14)
+         | ((u32)p->usedImprisonedMove << 16)
+         | ((u32)p->loveImmobility << 17)
+         | ((u32)p->usedDisabledMove << 18)
+         | ((u32)p->usedTauntedMove << 19)
+         | ((u32)p->flag2Unknown << 20)
+         | ((u32)p->flinchImmobility << 21)
+         | ((u32)p->notFirstStrike << 22)
+         | ((u32)p->palaceUnableToUseMove << 23)
+         | ((u32)p->usedHealBlockedMove << 24)
+         | ((u32)p->usedGravityPreventedMove << 25)
+         | ((u32)p->powderSelfDmg << 26)
+         | ((u32)p->usedThroatChopPreventedMove << 27)
+         | ((u32)p->statRaised << 28)
