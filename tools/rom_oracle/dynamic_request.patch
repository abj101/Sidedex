+
+// Release condition: a submitted request with a different requestId than the
+// one that created the hold. On release the action is latched for injection.
+static bool32 SidedexBoundaryWait(void)
+{
+    if (gSidedexDynamicRequest.status == SIDEDEX_DYNAMIC_SUBMITTED
+     && gSidedexDynamicRequest.requestId != sSidedexHoldRequestId)
+    {
+        // Contract 6.2: restore the token, then inject the RNG pair, then run,
+        // before any AI or choice evaluation. The mGBA savestate carries the
+        // RNG as of the held boundary, so a released boundary must overwrite
+        // BOTH streams from the mailbox; otherwise a restored node silently
+        // keeps the saved pair and the injected pair is ignored.
+        gRngValue = (rng_value_t){gSidedexDynamicRequest.mainRng.a,
+                                  gSidedexDynamicRequest.mainRng.b,
+                                  gSidedexDynamicRequest.mainRng.c,
+                                  gSidedexDynamicRequest.mainRng.ctr};
+        gRng2Value = (rng_value_t){gSidedexDynamicRequest.secondaryRng.a,
+                                   gSidedexDynamicRequest.secondaryRng.b,
+                                   gSidedexDynamicRequest.secondaryRng.c,
+                                   gSidedexDynamicRequest.secondaryRng.ctr};
+        sSidedexBoundaryHold = FALSE;
+        gSidedexDynamicRequest.status = SIDEDEX_DYNAMIC_RUNNING;
+        sSidedexInjectKind = gSidedexDynamicRequest.candidateKind;
+        sSidedexInjectMove = gSidedexDynamicRequest.playerMove;
+        sSidedexInjectSlot = gSidedexDynamicRequest.playerSlot;
+        sSidedexInjectMoveSlot = 0;
+        sSidedexInjectPending = TRUE;
+        return FALSE;
+    }
+    return TRUE;
+}
