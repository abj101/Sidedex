+// special_status_flags: the four flag bytes of struct SpecialStatus, packed in
+// declaration order (README "v9 flag words").
+static u32 SidedexPackSpecialStatusFlags(u32 battler)
+{
+    const struct SpecialStatus *s = &gSpecialStatuses[battler];
