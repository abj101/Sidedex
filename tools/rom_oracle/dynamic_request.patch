+         || (turn->opponentKind == SIDEDEX_DYNAMIC_SWITCH && (turn->opponentSlot == 0 || turn->opponentSlot >= request->opponentCount)))
+            return FALSE;
+    }
+    mainSeedPresent = request->mainRng.a | request->mainRng.b
+                    | request->mainRng.c | request->mainRng.ctr;
+    return mainSeedPresent;
+}
