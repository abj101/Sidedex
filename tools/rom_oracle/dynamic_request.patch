+static u32 SidedexBuildLegal(u32 battler, bool32 forcedSwitch, u32 turn, u32 *legal);
+
+// Header, CRC and the final binary-ready marker (contract C.1). The marker is
+// the last output of a transition.
+// Header + CRC (contract C.1). Committed before the boundary marker so the
+// worker's batch stop cannot catch a half-written result.
+static void SidedexCommitResultHeader(u32 turn, u32 boundary, u32 status)
+{
+    u32 total;
+    if (gSidedexDynamicResult == NULL)
+        return;
+    total = sSidedexResultLen;
+    gSidedexDynamicResult[0] = 'S';
+    gSidedexDynamicResult[1] = 'D';
+    gSidedexDynamicResult[2] = 'R';
+    gSidedexDynamicResult[3] = '2';
+    SidedexResultWrite16(4, 1);
+    SidedexResultWrite16(6, 64);
+    SidedexResultWrite32(8, total);
+    SidedexResultWrite32(12, 0);
+    SidedexResultWrite16(16, gSidedexDynamicRequest.requestId);
+    SidedexResultWrite16(18, status);
+    SidedexResultWrite16(20, boundary);
+    SidedexResultWrite16(22, gSidedexDynamicRequest.mode);
+    SidedexResultWrite16(24, gSidedexDynamicRequest.criticalPolicy);
+    SidedexResultWrite16(26, sSidedexRecordCount);
+    SidedexResultWrite32(28, turn);
+    SidedexResultWrite32(32, gRngValue.a);
+    SidedexResultWrite32(36, gRngValue.b);
+    SidedexResultWrite32(40, gRngValue.c);
+    SidedexResultWrite32(44, gRngValue.ctr);
+    SidedexResultWrite32(48, gRng2Value.a);
+    SidedexResultWrite32(52, gRng2Value.b);
+    SidedexResultWrite32(56, gRng2Value.c);
+    SidedexResultWrite32(60, gRng2Value.ctr);
+    SidedexResultWrite32(12, SidedexResultCrc32(&gSidedexDynamicResult[12], total - 12));
+}
+
+static void SidedexAnnounceResult(void)
+{
+    if (gSidedexDynamicResult == NULL)
+        return;
+    Test_MgbaPrintf("ROMTRACE|binary-ready|%d|%d", (u32)gSidedexDynamicResult, sSidedexResultLen);
+}
+
+static void SidedexFinishResult(u32 turn, u32 boundary, u32 status)
+{
+    SidedexCommitResultHeader(turn, boundary, status);
+    SidedexAnnounceResult();
+}
+
+// A nonzero status carries exactly tag 11 and no other record (contract C.1).
+static void SidedexCommitUnsupported(u32 turn, u32 status, u32 source)
+{
+    u32 w[SIDEDEX_UNSUPPORTED_WORDS];
+    SidedexResultBegin();
+    w[0] = status; // tag 11 reason uses the status numbering
+    w[1] = source;
+    SidedexAppendTyped(11, 1, SIDEDEX_UNSUPPORTED_WORDS, w);
+    // An error result carries no boundary: the reference vector for a nonzero
+    // status uses boundary 0 (sdr2_vectors/unsupported_status).
+    SidedexFinishResult(turn, SIDEDEX_BOUNDARY_NONE, status);
+    SidedexResetEvents();
+}
+
+// Tags 1..9 for a nonterminal boundary. The boundary marker is emitted by the
+// caller between the projection and binary-ready, so it stays the last
+// diagnostic record.
+static void SidedexEmitProjection(u32 turn, bool32 forcedSwitch, bool32 terminal)
+{
+    u32 battler = GetBattlerAtPosition(B_POSITION_PLAYER_LEFT);
+    u32 legal[SIDEDEX_MAX_LEGAL * SIDEDEX_LEGAL_WORDS];
+    u32 legalCount = 0;
+
+    SidedexEmitParty(turn);
+    SidedexEmitActive(turn);
+    SidedexEmitField(turn);
+    SidedexEmitSide(turn);
+    SidedexEmitBattle(turn);
+    SidedexEmitRng(turn);
+    if (!terminal)
+    {
+        legalCount = SidedexBuildLegal(battler, forcedSwitch, turn, legal);
+        SidedexAppendTyped(7, legalCount, SIDEDEX_LEGAL_WORDS, legal);
+    }
+    SidedexEmitTrainerAction(turn);
+    SidedexAppendEvents();
+    sSidedexLastLegalCount = legalCount;
+    // v8 diagnostics retained for the existing reader and rom_eval.py, but
+    // suppressed in compact transport (contract task 3).
+    if (!sSidedexCompact)
+    {
+        SidedexEmitPartyState(turn);
+        SidedexEmitActiveState(turn);
+        SidedexEmitFieldState(turn);
+        SidedexEmitBattleState(turn);
+        Test_MgbaPrintf("ROMTRACE|phase|%d|state|restore-source|mgba-savestate|held-at-boundary", turn);
+    }
+}
+
+static void SidedexCommitBoundary(u32 turn, u32 boundary, bool32 forcedSwitch, const char *label)
+{
+
+    if (gBattlersCount != NUM_BATTLE_SIDES)
+    {
+        SidedexCommitUnsupported(turn, SIDEDEX_STATUS_UNSUPPORTED, SIDEDEX_SOURCE_NON_SINGLES);
+        return;
+    }
+    // A refused item action is a diagnostic, not a failed turn: the ROM shows
+    // BattleScript_ActionSelectionItemsCantBeUsed and re-enters action selection
+    // (src/battle_main.c:4509), so the boundary is committed with the action the
+    // AI actually picks. The refusal itself stays visible as
+    // ROMTRACE|unrepresentable|trainer-item-decision.
+    SidedexResultBegin();
+    SidedexEmitProjection(turn, forcedSwitch, FALSE);
+    // Hard rule (contract Appendix C.1, revised): the 64-byte header and the CRC
+    // are written BEFORE any stop marker, and ROMTRACE|binary-ready| stays LAST
+    // so a diagnostic reader sees the whole projection first. The worker's stop
+    // policy, not this order, decides which marker a v3 batch records.
+    SidedexCommitResultHeader(turn, boundary, SIDEDEX_STATUS_OK);
+    Test_MgbaPrintf("ROMTRACE|boundary|%s|%d|%d", label, turn, sSidedexLastLegalCount);
+    Test_MgbaPrintf("ROMTRACE|phase|%d|boundary|%s|%d", turn, label, sSidedexLastLegalCount);
+    SidedexAnnounceResult();
+    SidedexResetEvents();
+}
+
+static void SidedexCommitTerminal(u32 turn, u32 result, u32 reason)
+{
+    if (gBattlersCount != NUM_BATTLE_SIDES)
+    {
+        SidedexCommitUnsupported(turn, SIDEDEX_STATUS_UNSUPPORTED, SIDEDEX_SOURCE_NON_SINGLES);
+        return;
+    }
+    SidedexResultBegin();
+    SidedexEmitProjection(turn, TRUE, TRUE);
+    SidedexEmitTerminal(turn, result, reason);
+    // Header + CRC first, marker afterwards; SidedexAnnounceResult is called by
+    // the terminal path once ROMTRACE|terminal| has been printed.
+    SidedexCommitResultHeader(turn, SIDEDEX_BOUNDARY_TERMINAL, SIDEDEX_STATUS_OK);
+}
+// Legal player actions at the boundary, enumerated from the ROM (contract 2.2
+// rule 4, and contract 2 `legal_player_actions`). Builds the tag 7 word array
+// (kind, id, pp_or_species, target_or_slot) and emits the v8 `ROMTRACE|legal|`
+// records. Player items are never enumerated: the fixture models no player bag,
+// and a trainer battle outside easy mode forbids item actions outright
+// (src/battle_main.c), so no `legal|item` record can be emitted here.
+static u32 SidedexBuildLegal(u32 battler, bool32 forcedSwitch, u32 turn, u32 *legal)
+{
+    u32 count = 0, i;
+    u32 activeSlot = gBattlerPartyIndexes[battler];
+    u32 switchOnly = forcedSwitch || gBattleMons[battler].hp == 0;
+
+    if (!switchOnly)
+    {
+        u32 target = GetBattlerAtPosition(B_POSITION_OPPONENT_LEFT);
+        for (i = 0; i < MAX_MON_MOVES && count < SIDEDEX_MAX_LEGAL; i++)
+        {
+            if (gBattleMons[battler].moves[i] == MOVE_NONE || gBattleMons[battler].pp[i] == 0)
+                continue;
+            legal[count * SIDEDEX_LEGAL_WORDS + 0] = 0;
+            legal[count * SIDEDEX_LEGAL_WORDS + 1] = gBattleMons[battler].moves[i];
+            legal[count * SIDEDEX_LEGAL_WORDS + 2] = gBattleMons[battler].pp[i];
+            legal[count * SIDEDEX_LEGAL_WORDS + 3] = target;
+            if (!sSidedexCompact)
+            {
+                Test_MgbaPrintf("ROMTRACE|legal|move|%d|%d|%d",
+                                gBattleMons[battler].moves[i], gBattleMons[battler].pp[i], target);
+                Test_MgbaPrintf("ROMTRACE|phase|%d|legal|move|%d|%d|%d", turn,
+                                gBattleMons[battler].moves[i], gBattleMons[battler].pp[i], target);
+            }
+            count++;
+        }
+    }
+    if (switchOnly || CanBattlerEscape(battler))
+    {
+        for (i = 0; i < gSidedexDynamicRequest.playerCount && count < SIDEDEX_MAX_LEGAL; i++)
+        {
+            if (i == activeSlot || GetMonData(&gPlayerParty[i], MON_DATA_HP, NULL) == 0)
+                continue;
+            legal[count * SIDEDEX_LEGAL_WORDS + 0] = 1;
+            legal[count * SIDEDEX_LEGAL_WORDS + 1] = i;
+            legal[count * SIDEDEX_LEGAL_WORDS + 2] = GetMonData(&gPlayerParty[i], MON_DATA_SPECIES, NULL);
+            legal[count * SIDEDEX_LEGAL_WORDS + 3] = i;
+            if (!sSidedexCompact)
+            {
+                Test_MgbaPrintf("ROMTRACE|legal|switch|%d|%d", i,
+                                GetMonData(&gPlayerParty[i], MON_DATA_SPECIES, NULL));
+                Test_MgbaPrintf("ROMTRACE|phase|%d|legal|switch|%d|%d", turn, i,
+                                GetMonData(&gPlayerParty[i], MON_DATA_SPECIES, NULL));
+            }
+            count++;
+        }
+    }
+    for (i = 0; i < count; i++)
+        SidedexTraceRecord("clegal", turn, i * SIDEDEX_LEGAL_WORDS,
+                           &legal[i * SIDEDEX_LEGAL_WORDS], SIDEDEX_LEGAL_WORDS);
+    return count;
+}
+
+// Legal player actions at the boundary, enumerated from the ROM (contract 2.2
+// rule 4). Forced switch (active fainted) offers switches only.
+static u32 SidedexLegalActionCount(u32 battler)
+{
+    u32 i, count = 0;
+    u32 activeSlot = gBattlerPartyIndexes[battler];
+    if (gBattleMons[battler].hp == 0)
+    {
+        for (i = 0; i < gSidedexDynamicRequest.playerCount; i++)
+            if (i != activeSlot && GetMonData(&gPlayerParty[i], MON_DATA_HP, NULL) != 0)
+                count++;
+        return count;
+    }
+    for (i = 0; i < MAX_MON_MOVES; i++)
+        if (gBattleMons[battler].moves[i] != MOVE_NONE && gBattleMons[battler].pp[i] != 0)
+            count++;
+    if (CanBattlerEscape(battler))
+    {
+        for (i = 0; i < gSidedexDynamicRequest.playerCount; i++)
+            if (i != activeSlot && GetMonData(&gPlayerParty[i], MON_DATA_HP, NULL) != 0)
+                count++;
+    }
+    return count;
+}
