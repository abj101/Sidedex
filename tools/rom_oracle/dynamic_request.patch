+bool32 TestRunner_Battle_RunQuery(u32 battlerId)
+{
+    u32 moveSlot;
+
+    if (!SidedexDynamicTraceActive()
+     || !SidedexDynamicQuery()
+     || GetBattlerSide(battlerId) != B_SIDE_OPPONENT
+     || gBattleResults.battleTurnCounter < gSidedexDynamicRequest.replayCount)
+        return FALSE;
+
+    Test_MgbaPrintf("ROMTRACE|critical-policy|%s|%s",
+                    SidedexCriticalPolicyLabel(), SidedexCriticalPolicyMechanism());
+    Test_MgbaPrintf("ROMTRACE|query|context|%s",
+                    gSidedexDynamicRequest.replayCount
+                     && gSidedexDynamicRequest.replay.playerKind == SIDEDEX_DYNAMIC_SWITCH
+                        ? "post-switch" : "current-state");
+    // The query is taken at the same pre-choice decision point as a boundary,
+    // so the ROM-derived legal player actions are reported here too.
+    SidedexEmitLegalActions(GetBattlerAtPosition(B_POSITION_PLAYER_LEFT),
+                            gBattleResults.battleTurnCounter, FALSE);
+    for (moveSlot = 0; moveSlot < gBattlersCount; moveSlot++)
+    {
+        u32 side = GetBattlerSide(moveSlot);
+        u32 slot = SidedexDynamicPartySlot(moveSlot);
+        struct BattlePokemon *mon = &gBattleMons[moveSlot];
+        u32 m;
+        Test_MgbaPrintf("ROMTRACE|query|active|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d",
+                        side, slot, mon->species, mon->hp, mon->maxHP,
+                        mon->statStages[STAT_ATK], mon->statStages[STAT_DEF],
+                        mon->statStages[STAT_SPEED], mon->statStages[STAT_SPATK],
+                        mon->statStages[STAT_SPDEF], mon->statStages[STAT_ACC],
+                        mon->statStages[STAT_EVASION]);
+        for (m = 0; m < MAX_MON_MOVES; m++)
+            Test_MgbaPrintf("ROMTRACE|query|active-move|%d|%d|%d", side, m, mon->moves[m]);
+    }
+    for (moveSlot = 0; moveSlot < MAX_MON_MOVES; moveSlot++)
+    {
+        u32 move = gBattleMons[B_POSITION_PLAYER_LEFT].moves[moveSlot];
+        if (move != MOVE_NONE)
+            SidedexQueryMove(B_SIDE_PLAYER, B_POSITION_PLAYER_LEFT,
+                             B_POSITION_OPPONENT_LEFT, move);
+    }
+    for (moveSlot = 0; moveSlot < MAX_MON_MOVES; moveSlot++)
+    {
+        u32 move = gBattleMons[B_POSITION_OPPONENT_LEFT].moves[moveSlot];
+        if (move != MOVE_NONE)
+            SidedexQueryMove(B_SIDE_OPPONENT, B_POSITION_OPPONENT_LEFT,
+                             B_POSITION_PLAYER_LEFT, move);
+    }
+
+    AI_TrySwitchOrUseItem(battlerId);
+    u8 action = gBattleResources->bufferB[battlerId][1];
+    if (action == B_ACTION_USE_ITEM)
+        Test_MgbaPrintf("ROMTRACE|query|ai|item|%d", gBattleStruct->chosenItem[battlerId]);
+    else if (action == B_ACTION_SWITCH)
+        Test_MgbaPrintf("ROMTRACE|query|ai|switch|%d",
+                        gBattleStruct->monToSwitchIntoId[battlerId]);
+    else
+    {
+        moveSlot = gBattleStruct->aiMoveOrAction[battlerId];
+        Test_MgbaPrintf("ROMTRACE|query|ai|move|%d",
+                        gBattleMons[battlerId].moves[moveSlot]);
+    }
+    gSidedexDynamicRequest.status = SIDEDEX_DYNAMIC_COMPLETE;
+    Test_MgbaPrintf("ROMTRACE|query|complete");
+    Test_MgbaPrintf("ROMTRACE|complete|0");
+    return TRUE;
+}
