+                        mon->moves[0], mon->moves[1], mon->moves[2], mon->moves[3],
+                        mon->pp[0], mon->pp[1], mon->pp[2], mon->pp[3],
+                        mon->types[0], mon->types[1], mon->types[2]);
+        SidedexOracleTraceBlob(turn, battler, 0, "battle-mon", mon, sizeof(*mon));
+        SidedexOracleTraceBlob(turn, battler, 0, "disable", &gDisableStructs[battler], sizeof(gDisableStructs[battler]));
+        SidedexOracleTraceBlob(turn, battler, 0, "protect", &gProtectStructs[battler], sizeof(gProtectStructs[battler]));
+        SidedexOracleTraceBlob(turn, battler, 0, "special", &gSpecialStatuses[battler], sizeof(gSpecialStatuses[battler]));
+    }
+    for (side = 0; side < NUM_BATTLE_SIDES; side++)
