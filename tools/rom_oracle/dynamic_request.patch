+    for (side = 0; side < NUM_BATTLE_SIDES; side++)
+    {
+        struct Pokemon *party = side == B_SIDE_PLAYER ? gPlayerParty : gEnemyParty;
+        for (slot = 0; slot < PARTY_SIZE; slot++)
+        {
+            struct Pokemon *mon = &party[slot];
+            u32 w[SIDEDEX_PARTY_WORDS];
+            u32 species = GetMonData(mon, MON_DATA_SPECIES, NULL);
+            w[0] = side;
+            w[1] = slot;
+            w[2] = species;
+            w[3] = GetMonData(mon, MON_DATA_LEVEL, NULL);
+            w[4] = GetMonData(mon, MON_DATA_HP, NULL);
+            w[5] = GetMonData(mon, MON_DATA_MAX_HP, NULL);
+            w[6] = GetMonData(mon, MON_DATA_STATUS, NULL);
+            w[7] = GetMonData(mon, MON_DATA_HELD_ITEM, NULL);
+            w[8] = GetMonData(mon, MON_DATA_ABILITY_NUM, NULL);
+            w[9] = GetFormIdFromFormSpeciesId(species);
+            w[10] = GetNature(mon);
+            w[11] = GetMonData(mon, MON_DATA_MOVE1, NULL);
+            w[12] = GetMonData(mon, MON_DATA_MOVE2, NULL);
+            w[13] = GetMonData(mon, MON_DATA_MOVE3, NULL);
+            w[14] = GetMonData(mon, MON_DATA_MOVE4, NULL);
+            w[15] = GetMonData(mon, MON_DATA_PP1, NULL);
+            w[16] = GetMonData(mon, MON_DATA_PP2, NULL);
+            w[17] = GetMonData(mon, MON_DATA_PP3, NULL);
+            w[18] = GetMonData(mon, MON_DATA_PP4, NULL);
+            w[19] = GetMonData(mon, MON_DATA_HP_IV, NULL);
+            w[20] = GetMonData(mon, MON_DATA_ATK_IV, NULL);
+            w[21] = GetMonData(mon, MON_DATA_DEF_IV, NULL);
+            w[22] = GetMonData(mon, MON_DATA_SPEED_IV, NULL);
+            w[23] = GetMonData(mon, MON_DATA_SPATK_IV, NULL);
+            w[24] = GetMonData(mon, MON_DATA_SPDEF_IV, NULL);
+            w[25] = GetMonData(mon, MON_DATA_HP_EV, NULL);
+            w[26] = GetMonData(mon, MON_DATA_ATK_EV, NULL);
+            w[27] = GetMonData(mon, MON_DATA_DEF_EV, NULL);
+            w[28] = GetMonData(mon, MON_DATA_SPEED_EV, NULL);
+            w[29] = GetMonData(mon, MON_DATA_SPATK_EV, NULL);
+            w[30] = GetMonData(mon, MON_DATA_SPDEF_EV, NULL);
+            w[31] = species != SPECIES_NONE ? 1 : 0;
+            for (i = 0; i < SIDEDEX_PARTY_WORDS; i++)
+                SidedexAppend32(w[i]);
+            SidedexTraceRecord("cparty", turn, (side * PARTY_SIZE + slot) * SIDEDEX_PARTY_WORDS, w, SIDEDEX_PARTY_WORDS);
+        }
+    }
