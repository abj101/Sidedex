+    if (request->replayCount)
+    {
+        const volatile struct SidedexDynamicTurn *turn = &request->replay;
+        if (turn->playerKind > SIDEDEX_DYNAMIC_SWITCH || turn->opponentKind > SIDEDEX_DYNAMIC_SWITCH)
