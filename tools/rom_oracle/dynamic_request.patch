+bool32 SidedexDynamicInjectedActionPending(void)
+{
+    return sSidedexInjectPending;
+}
+
+// Called by the recorded player controller. The recorded bytes are still
+// consumed so the playback cursor stays aligned; only the returned value is
+// replaced. kind/byte1/byte2 are the ROM's own defaults.
+void SidedexDynamicInjectPlayerAction(u32 battler, u8 *action, u8 *byte1, u8 *byte2)
+{
+    if (!sSidedexInjectPending || battler != GetBattlerAtPosition(B_POSITION_PLAYER_LEFT))
+        return;
+    if (sSidedexInjectKind == SIDEDEX_DYNAMIC_MOVE)
+    {
+        u32 i;
+        for (i = 0; i < MAX_MON_MOVES; i++)
+        {
+            if (gBattleMons[battler].moves[i] == sSidedexInjectMove)
+            {
+                sSidedexInjectMoveSlot = i;
+                break;
+            }
+        }
+        *action = B_ACTION_USE_MOVE;
+        *byte1 = sSidedexInjectMoveSlot;
+        // Leave *byte2 (the recorded move target) untouched: replacing it with a
+        // default makes the move target the player's own battler.
+    }
+    else
+    {
+        *action = B_ACTION_SWITCH;
+        *byte1 = sSidedexInjectSlot & 0xFF;
+    }
+}
+
+void TestRunner_Battle_EmitTerminal(void)
+{
+    const char *result, *reason;
+    if (!SidedexDynamicTraceActive() || sSidedexTerminalEmitted)
+        return;
+    if (gBattleOutcome == 0 && !NoAliveMonsForEitherParty())
+        return;
+    switch (gBattleOutcome)
+    {
+    case B_OUTCOME_WON:
+        result = "win"; reason = "opponent-all-fainted"; break;
+    case B_OUTCOME_LOST:
+    case B_OUTCOME_FORFEITED:
+        result = "loss"; reason = "player-all-fainted"; break;
+    case B_OUTCOME_DREW:
+        result = "draw"; reason = "both-parties-fainted"; break;
+    default:
+        result = NoAliveMonsForEitherParty()
+            ? (GetMonData(&gPlayerParty[0], MON_DATA_HP, NULL) == 0 ? "loss" : "win")
+            : "draw";
+        reason = "battle-ended"; break;
+    }
+    sSidedexTerminalEmitted = TRUE;
+    Test_MgbaPrintf("ROMTRACE|terminal|%s|%s", result, reason);
+    Test_MgbaPrintf("ROMTRACE|phase|%d|terminal|%s|%s", gBattleResults.battleTurnCounter,
+                    result, reason);
+}
+
+// Reset per-request bookkeeping when a new request is accepted. Called from the
+// test runner right before a request is validated/run.
+void SidedexDynamicResetRequest(void)
+{
+    sSidedexBoundaryHold = FALSE;
+    sSidedexInjectPending = FALSE;
+    sSidedexInjectMoveSlot = 0;
+    sSidedexInstructions = 0;
+    sSidedexBudgetReported = FALSE;
+    sSidedexTerminalEmitted = FALSE;
+    sSidedexUnrepresentableEmitted = FALSE;
+    sSidedexItemRefused = FALSE;
+}
+
+enum
+{
+    SIDEDEX_QUERY_UNSUPPORTED = 1 << 0,
+    SIDEDEX_QUERY_FOCUS_SASH = 1 << 1,
+    SIDEDEX_QUERY_STURDY = 1 << 2,
+    SIDEDEX_QUERY_MULTI_HIT_RANGE = 1 << 3,
+    SIDEDEX_QUERY_MULTI_HIT_ENUMERATED = 1 << 4,
+};
+
+enum
+{
+    SIDEDEX_HITS_STANDARD,
+    SIDEDEX_HITS_LOADED_DICE,
+    SIDEDEX_HITS_SKILL_LINK,
+    SIDEDEX_HITS_BATTLE_BOND,
+    SIDEDEX_HITS_FIXED,
+};
+
+static bool32 sSidedexQueryRngActive;
+static enum RandomTag sSidedexQueryRngTag;
+static u32 sSidedexQueryRngValue;
+
+static s32 SidedexQueryDamage(u32 battlerAtk, u32 battlerDef, u32 move, bool32 critical, u32 roll)
+{
+    struct DamageCalculationData damageCalcData = {
+        .battlerAtk = battlerAtk,
+        .battlerDef = battlerDef,
+        .move = move,
+        .moveType = GetMoveType(move),
+        .isCrit = critical,
+        .randomFactor = TRUE,
+        .updateFlags = FALSE,
+    };
+    s32 damage;
+
+    sSidedexQueryRngActive = TRUE;
+    sSidedexQueryRngTag = RNG_DAMAGE_MODIFIER;
+    sSidedexQueryRngValue = roll;
+    damage = CalculateMoveDamage(&damageCalcData, 0);
+    sSidedexQueryRngActive = FALSE;
+    return max(0, damage);
+}
+
+// ---- Outcome-weight enumeration (contract phase 2, deliverable A2-3) -------
+// The ROM enumerates the COMPLETE joint distribution over the target's
+// remaining HP after the candidate move, so the Python layer only has to sum
+// integers. Weights are parts-per-million (denominator 1000000) of the exact
+// integer probability; the largest branch absorbs rounding, so every record's
+// weights sum exactly to the reported denominator. Mechanics folded in-ROM:
+// the engine damage roll spread (16 rolls via CalculateMoveDamage), the real
+// crit odds (critDen), the composed accuracy percent (GetTotalAccuracy),
+// per-hit crit/damage independence, the engine multi-hit count distribution
+// (src/battle_util.c SetRandomMultiHitCounter: RandomWeighted 7/7/3/3 for
+// 2/3/4/5, Loaded Dice 4..5, Skill Link 5), miss-terminates-the-sequence, and
+// Focus Sash / Sturdy at full HP (single-hit moves only; a multi-hit move
+// still KOs through them).
+//
+// Record spelling (also in tools/rom_oracle/README.md and Appendix A):
+//   ROMTRACE|query|outcomes|<owner>|<move>|<flags>|<chunk>|<chunks>|<denom>
+//          |<branches>|<hitsMode>|<minHits>|<maxHits>|<accuracy>
+//          |<hp>|<weight>|...            (<= 8 pairs per record)
+// flags bits: 1 multi-hit, 2 focus-sash folded in, 4 sturdy folded in,
+//             8 accuracy<100, 16 enumeration refused (0 branches).
+#define SDX_OUTCOME_DENOM 1000000
+// Damage/HP axis bound. Scratch is deliberately small (IWRAM is nearly full in
+// the test build): three s32 arrays of this size, reusing one for the HP fold.
+// Fixtures have maxHP <= 155 and per-hit damage <= ~120, so 256 is exact for
+// them; if a value clamps, flag bit 32 is set and the record says so.
+#define SDX_OUTCOME_MAXSUM 256
+#define SDX_OUTCOME_PER_RECORD 8
+#define SDX_OUTCOME_REFUSED 16
+#define SDX_OUTCOME_CLAMPED 32
+
+static s32 sSdxOutHitDmg[40];
+static s32 sSdxOutHitW[40];
+static s32 sSdxOutCur[SDX_OUTCOME_MAXSUM];
+static s32 sSdxOutTmp[SDX_OUTCOME_MAXSUM];
+static s32 sSdxOutAcc[SDX_OUTCOME_MAXSUM];
+static u8 sSdxOutBuf[512];
+
+static s32 SidedexOutScale(s32 a, s32 b)
+{
+    if (a <= 0 || b <= 0)
+        return 0;
+    return (s32)(((s64)a * (s64)b + SDX_OUTCOME_DENOM / 2) / SDX_OUTCOME_DENOM);
+}
+
+static u32 SidedexBufFieldInt(u8 *buf, u32 len, s32 v)
+{
+    u8 tmp[12];
+    u32 n = 0, i;
+    buf[len++] = '|';
+    if (v < 0)
+    {
+        buf[len++] = '-';
+        v = -v;
+    }
+    do
+    {
+        tmp[n++] = (u8)('0' + (v % 10));
+        v /= 10;
+    } while (v);
+    for (i = 0; i < n; i++)
+        buf[len++] = tmp[n - 1 - i];
+    return len;
+}
+
+static void SidedexEmitOutcomesRefused(u32 owner, u32 move, u32 flags)
+{
+    u32 len = 0;
+    const char *head = "ROMTRACE|query|outcomes";
+    while (*head)
+        sSdxOutBuf[len++] = *head++;
+    len = SidedexBufFieldInt(sSdxOutBuf, len, owner);
+    len = SidedexBufFieldInt(sSdxOutBuf, len, move);
+    len = SidedexBufFieldInt(sSdxOutBuf, len, (s32)(flags | SDX_OUTCOME_REFUSED));
+    len = SidedexBufFieldInt(sSdxOutBuf, len, 0);
+    len = SidedexBufFieldInt(sSdxOutBuf, len, 0);
+    len = SidedexBufFieldInt(sSdxOutBuf, len, SDX_OUTCOME_DENOM);
+    len = SidedexBufFieldInt(sSdxOutBuf, len, 0);
+    len = SidedexBufFieldInt(sSdxOutBuf, len, 0);
+    len = SidedexBufFieldInt(sSdxOutBuf, len, 1);
+    len = SidedexBufFieldInt(sSdxOutBuf, len, 1);
+    len = SidedexBufFieldInt(sSdxOutBuf, len, 0);
+    sSdxOutBuf[len] = 0;
+    Test_MgbaPrintf("%s", sSdxOutBuf);
+}
+
+static void SidedexEmitOutcomeWeights(u32 owner, u32 move, u32 battlerDef,
+                                      const u32 rollDamage[2][16],
+                                      u32 nonCritWeight, u32 critWeight,
+                                      u32 accuracy, u32 minHits, u32 maxHits,
+                                      u32 hitsMode, u32 flags)
+{
+    u32 i, j, k, idx, dmg;
+    u32 nHit = 0, nHitCounts = 0, hitDen = 1;
+    u32 hitCnt[8], hitWgt[8];
+    u32 perHitDen, hp = gBattleMons[battlerDef].hp, maxHp = gBattleMons[battlerDef].maxHP;
+    u32 outFlags = 0, branches = 0, chunks, chunk, curMax, newMax = 0, maxPerHit = 0;
+    s32 accW, missW, sum = 0, best = 0;
+    u32 multiHit = (flags & SIDEDEX_QUERY_MULTI_HIT_RANGE) != 0;
+    u32 sash = (flags & SIDEDEX_QUERY_FOCUS_SASH) != 0;
+    u32 sturdy = (flags & SIDEDEX_QUERY_STURDY) != 0;
+
+    perHitDen = 16 * (nonCritWeight + critWeight);
+    if (hp == 0)
+        return;
+    if (accuracy > 100)
+        accuracy = 100;
+
+    if (multiHit)
+        outFlags |= 1;
+    // Sash/sturdy are only *applied* (folded into the distribution) on a
+    // single-hit move; a multi-hit move KOs through both, so the flag would lie.
+    if (sash && !multiHit)
+        outFlags |= 2;
+    if (sturdy && !multiHit)
+        outFlags |= 4;
+    if (accuracy < 100)
+        outFlags |= 8;
+
+    for (i = 0; i < SDX_OUTCOME_MAXSUM; i++)
+        sSdxOutAcc[i] = 0;
+
+    if (gMovesInfo[move].category == DAMAGE_CATEGORY_STATUS)
+    {
+        // A status move never changes HP: one certain branch.
+        sSdxOutAcc[0] = SDX_OUTCOME_DENOM;
+    }
+    else
+    {
+        if (perHitDen == 0)
+        {
+            SidedexEmitOutcomesRefused(owner, move, outFlags);
+            return;
+        }
+        // Per-hit distribution conditional on the hit landing, DENOM scale.
+        for (i = 0; i < 16; i++)
+        {
+            if (nonCritWeight)
+            {
+                sSdxOutHitDmg[nHit] = (s32)rollDamage[0][i];
+                sSdxOutHitW[nHit++] = (s32)(((s64)SDX_OUTCOME_DENOM * nonCritWeight + perHitDen / 2) / perHitDen);
+            }
+            if (critWeight)
+            {
+                sSdxOutHitDmg[nHit] = (s32)rollDamage[1][i];
+                sSdxOutHitW[nHit++] = (s32)(((s64)SDX_OUTCOME_DENOM * critWeight + perHitDen / 2) / perHitDen);
+            }
+        }
+        if (nHit == 0)
+        {
+            SidedexEmitOutcomesRefused(owner, move, outFlags);
+            return;
+        }
+        for (i = 0; i < nHit; i++)
+        {
+            sum += sSdxOutHitW[i];
+            if ((u32)sSdxOutHitDmg[i] > maxPerHit)
+                maxPerHit = (u32)sSdxOutHitDmg[i];
+        }
+        sSdxOutHitW[0] += (s32)SDX_OUTCOME_DENOM - sum; // exact sum
+
+        switch (hitsMode)
+        {
+        case SIDEDEX_HITS_STANDARD:
+            hitCnt[0] = 2; hitWgt[0] = 7; hitCnt[1] = 3; hitWgt[1] = 7;
+            hitCnt[2] = 4; hitWgt[2] = 3; hitCnt[3] = 5; hitWgt[3] = 3;
+            nHitCounts = 4; hitDen = 20; break;
+        case SIDEDEX_HITS_LOADED_DICE:
+            hitCnt[0] = 4; hitWgt[0] = 1; hitCnt[1] = 5; hitWgt[1] = 1;
+            nHitCounts = 2; hitDen = 2; break;
+        case SIDEDEX_HITS_SKILL_LINK:
+            hitCnt[0] = 5; hitWgt[0] = 1; nHitCounts = 1; hitDen = 1; break;
+        case SIDEDEX_HITS_BATTLE_BOND:
+            hitCnt[0] = 3; hitWgt[0] = 1; nHitCounts = 1; hitDen = 1; break;
+        default:
+            hitCnt[0] = minHits; hitWgt[0] = 1; nHitCounts = 1; hitDen = 1; break;
+        }
+        if (maxHits < minHits)
+            maxHits = minHits;
+        if (maxHits == 0)
+            maxHits = 1;
+
+        accW = (s32)(((s64)SDX_OUTCOME_DENOM * accuracy + 50) / 100);
+        missW = (s32)SDX_OUTCOME_DENOM - accW;
+
+        for (idx = 0; idx < nHitCounts; idx++)
+        {
+            s32 hn = (s32)(((s64)SDX_OUTCOME_DENOM * hitWgt[idx]) / hitDen);
+            s32 runW = hn;
+            for (i = 0; i < SDX_OUTCOME_MAXSUM; i++)
+                sSdxOutCur[i] = 0;
+            sSdxOutCur[0] = SDX_OUTCOME_DENOM;
+            curMax = 0;
+            for (k = 0; k <= hitCnt[idx]; k++)
+            {
+                s32 wSeq;
+                if (k > 0)
+                {
+                    newMax = curMax + maxPerHit;
+                    if (newMax > SDX_OUTCOME_MAXSUM - 1)
+                        newMax = SDX_OUTCOME_MAXSUM - 1;
+                    for (i = 0; i < SDX_OUTCOME_MAXSUM; i++)
+                        sSdxOutTmp[i] = 0;
+                    for (dmg = 0; dmg <= curMax; dmg++)
+                    {
+                        if (sSdxOutCur[dmg] == 0)
+                            continue;
+                        for (j = 0; j < nHit; j++)
+                        {
+                            u32 t = dmg + (u32)sSdxOutHitDmg[j];
+                            if (t > newMax)
+                                t = newMax;
+                            sSdxOutTmp[t] += SidedexOutScale(sSdxOutCur[dmg], sSdxOutHitW[j]);
+                        }
+                    }
+                    for (i = 0; i <= newMax; i++)
+                        sSdxOutCur[i] = sSdxOutTmp[i];
+                    curMax = newMax;
+                    runW = SidedexOutScale(runW, accW); // reached k hits
+                }
+                // k < n: the next hit missed and ended the sequence.
+                // k == n: every allowed hit landed.
+                wSeq = (k < hitCnt[idx]) ? SidedexOutScale(runW, missW) : runW;
+                for (i = 0; i <= curMax; i++)
+                    if (sSdxOutCur[i])
+                        sSdxOutAcc[i] += SidedexOutScale(sSdxOutCur[i], wSeq);
+            }
+        }
+    }
+
+    // Fold damage into the target's remaining HP; sash/sturdy clamp full-HP KOs.
+    // The convolution scratch is finished with, so reuse it for the HP buckets.
+    for (i = 0; i < SDX_OUTCOME_MAXSUM; i++)
+        sSdxOutCur[i] = 0;
+    for (dmg = 0; dmg < SDX_OUTCOME_MAXSUM; dmg++)
+    {
+        s32 w = sSdxOutAcc[dmg];
+        u32 finalHp;
+        if (w == 0)
+            continue;
+        if (gMovesInfo[move].category != DAMAGE_CATEGORY_STATUS && dmg >= (s32)hp)
+            finalHp = (!multiHit && (sash || sturdy) && hp == maxHp) ? 1 : 0;
+        else
+            finalHp = hp - dmg;
+        if (finalHp >= SDX_OUTCOME_MAXSUM)
+        {
+            finalHp = SDX_OUTCOME_MAXSUM - 1;
+            outFlags |= SDX_OUTCOME_CLAMPED;
+        }
+        sSdxOutCur[finalHp] += w;
+    }
+    {
+        u32 hpLimit = min(hp + 1, (u32)SDX_OUTCOME_MAXSUM);
+        branches = 0;
+        sum = 0;
+        best = -1;
+        for (i = 0; i < hpLimit; i++)
+        {
+            if (sSdxOutCur[i] <= 0)
+                continue;
+            branches++;
+            sum += sSdxOutCur[i];
+            if (best < 0 || sSdxOutCur[i] > sSdxOutCur[best])
+                best = (s32)i;
+        }
+        if (branches == 0)
+        {
+            SidedexEmitOutcomesRefused(owner, move, outFlags);
+            return;
+        }
+        sSdxOutCur[best] += (s32)SDX_OUTCOME_DENOM - sum; // exact sum
+    }
+
+    chunks = (branches + SDX_OUTCOME_PER_RECORD - 1) / SDX_OUTCOME_PER_RECORD;
+    for (chunk = 0; chunk < chunks; chunk++)
+    {
+        u32 hpLimit = min(hp + 1, (u32)SDX_OUTCOME_MAXSUM);
+        u32 seen = 0, emitted = 0;
+        u32 len = 0;
+        const char *head = "ROMTRACE|query|outcomes";
+        while (*head)
+            sSdxOutBuf[len++] = *head++;
+        len = SidedexBufFieldInt(sSdxOutBuf, len, owner);
+        len = SidedexBufFieldInt(sSdxOutBuf, len, move);
+        len = SidedexBufFieldInt(sSdxOutBuf, len, (s32)outFlags);
+        len = SidedexBufFieldInt(sSdxOutBuf, len, (s32)chunk);
+        len = SidedexBufFieldInt(sSdxOutBuf, len, (s32)chunks);
+        len = SidedexBufFieldInt(sSdxOutBuf, len, SDX_OUTCOME_DENOM);
+        len = SidedexBufFieldInt(sSdxOutBuf, len, (s32)branches);
+        len = SidedexBufFieldInt(sSdxOutBuf, len, (s32)hitsMode);
+        len = SidedexBufFieldInt(sSdxOutBuf, len, (s32)minHits);
+        len = SidedexBufFieldInt(sSdxOutBuf, len, (s32)maxHits);
+        len = SidedexBufFieldInt(sSdxOutBuf, len, (s32)accuracy);
+        for (i = 0; i < hpLimit && emitted < SDX_OUTCOME_PER_RECORD; i++)
+        {
+            if (sSdxOutCur[i] <= 0)
+                continue;
+            if (seen++ < chunk * SDX_OUTCOME_PER_RECORD)
+                continue;
+            len = SidedexBufFieldInt(sSdxOutBuf, len, (s32)i);
+            len = SidedexBufFieldInt(sSdxOutBuf, len, sSdxOutCur[i]);
+            emitted++;
+        }
+        sSdxOutBuf[len] = 0;
+        Test_MgbaPrintf("%s", sSdxOutBuf);
+    }
+}
