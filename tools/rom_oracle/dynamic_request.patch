+// Tag 1 party (12 x 32): struct Pokemon via GetMonData, gPlayerParty /
+// gEnemyParty. form is GetFormIdFromFormSpeciesId(species) (include/pokemon.h).
+static void SidedexEmitParty(u32 turn)
+{
