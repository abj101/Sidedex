+void TestRunner_Battle_EmitTerminal(void)
+{
+    const char *result, *reason;
+    u32 resultCode, reasonCode = 0;
+    if (!SidedexDynamicTraceActive() || sSidedexTerminalEmitted)
+        return;
+    if (gBattleOutcome == 0 && !NoAliveMonsForEitherParty())
+        return;
+    switch (gBattleOutcome)
+    {
+    case B_OUTCOME_WON:
+        result = "win"; reason = "opponent-all-fainted"; resultCode = 1; break;
+    case B_OUTCOME_LOST:
+        result = "loss"; reason = "player-all-fainted"; resultCode = 2; break;
+    case B_OUTCOME_FORFEITED:
+        result = "loss"; reason = "player-all-fainted"; resultCode = 2; reasonCode = 1; break;
+    case B_OUTCOME_DREW:
+        result = "draw"; reason = "both-parties-fainted"; resultCode = 3; break;
+    default:
+        if (NoAliveMonsForEitherParty())
+        {
+            resultCode = GetMonData(&gPlayerParty[0], MON_DATA_HP, NULL) == 0 ? 2 : 1;
+            result = resultCode == 2 ? "loss" : "win";
+        }
+        else
+        {
+            resultCode = 3;
+            result = "draw";
+        }
+        reason = "battle-ended"; break;
+    }
+    sSidedexTerminalEmitted = TRUE;
+    if (gSidedexDynamicResult != NULL)
+        SidedexCommitTerminal(gBattleResults.battleTurnCounter, resultCode, reasonCode);
+    Test_MgbaPrintf("ROMTRACE|terminal|%s|%s", result, reason);
+    Test_MgbaPrintf("ROMTRACE|phase|%d|terminal|%s|%s", gBattleResults.battleTurnCounter,
+                    result, reason);
+    if (gSidedexDynamicResult != NULL)
+    {
+        SidedexAnnounceResult();
+        SidedexResetEvents();
+    }
+}
