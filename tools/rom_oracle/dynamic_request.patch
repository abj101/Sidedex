+// Tag 2 active (2 x 37): struct BattlePokemon gBattleMons[] plus the Disable,
+// Protect and SpecialStatus structs.
+static void SidedexEmitActive(u32 turn)
+{
+    u32 battler, i;
+    SidedexBeginTyped(2, NUM_BATTLE_SIDES, SIDEDEX_ACTIVE_WORDS);
+    for (battler = 0; battler < NUM_BATTLE_SIDES; battler++)
+    {
+        const struct BattlePokemon *mon = &gBattleMons[battler];
+        u32 w[SIDEDEX_ACTIVE_WORDS];
+        w[0] = battler;
+        // gBattleStruct->battlerPartyIndexes is not the slot in play: it holds the slot the
+        // battler came FROM (written when a switch is chosen, read by the switch-out message
+        // and the knock-off check), so after a voluntary switch it is stale and the legal
+        // action list would offer the monster already in play. gBattlerPartyIndexes is
+        // updated by the switch command itself.
+        w[1] = gBattlerPartyIndexes[battler];
+        w[2] = mon->species;
+        w[3] = mon->hp;
+        w[4] = mon->maxHP;
+        w[5] = mon->status1;
+        w[6] = mon->status2;
+        w[7] = gStatuses3[battler];
+        w[8] = mon->ability;
+        w[9] = mon->item;
+        w[10] = GetFormIdFromFormSpeciesId(mon->species);
+        w[11] = mon->types[0];
+        w[12] = mon->types[1];
+        w[13] = mon->types[2];
+        w[14] = mon->statStages[STAT_ATK];
+        w[15] = mon->statStages[STAT_DEF];
+        w[16] = mon->statStages[STAT_SPEED];
+        w[17] = mon->statStages[STAT_SPATK];
+        w[18] = mon->statStages[STAT_SPDEF];
+        w[19] = mon->statStages[STAT_ACC];
+        w[20] = mon->statStages[STAT_EVASION];
+        w[21] = mon->moves[0];
+        w[22] = mon->moves[1];
+        w[23] = mon->moves[2];
+        w[24] = mon->moves[3];
+        w[25] = mon->pp[0];
+        w[26] = mon->pp[1];
+        w[27] = mon->pp[2];
+        w[28] = mon->pp[3];
+        w[29] = SidedexPackVolatileFlags(battler);
+        w[30] = gDisableStructs[battler].disabledMove;
+        w[31] = gDisableStructs[battler].disableTimer;
+        w[32] = SidedexPackProtectFlags(battler);
+        w[33] = SidedexPackSpecialStatusFlags(battler);
+        w[34] = gDisableStructs[battler].substituteHP;
+        w[35] = gDisableStructs[battler].encoreTimer;
+        w[36] = gDisableStructs[battler].tauntTimer;
+        for (i = 0; i < SIDEDEX_ACTIVE_WORDS; i++)
+            SidedexAppend32(w[i]);
+        SidedexTraceRecord("cactive", turn, battler * SIDEDEX_ACTIVE_WORDS, w, SIDEDEX_ACTIVE_WORDS);
+    }
+}
