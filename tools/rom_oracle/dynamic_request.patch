+    Test_MgbaPrintf("ROMTRACE|rng|%d|%d|%d|%d|%d|%d|%d|%d|%d",
+                    turn, gRngValue.a, gRngValue.b, gRngValue.c, gRngValue.ctr,
+                    gRng2Value.a, gRng2Value.b, gRng2Value.c, gRng2Value.ctr);
