new file mode 100644
index 0000000000..6525b9250e
--- /dev/null
+++ b/test/battle/ai/sidedex_dynamic.c
@@ -0,0 +1,95 @@
+#include "global.h"
+#include "test/battle.h"
+#include "test/sidedex_dynamic.h"
+
+AI_SINGLE_BATTLE_TEST(SIDEDEX_DYNAMIC_TEST_NAME)
+{
+    const volatile struct SidedexDynamicRequest *request = &gSidedexDynamicRequest;
+    u32 partySlot, moveSlot;
+
+    GIVEN {
+        RNGSeed(((rng_value_t){request->mainRng.a, request->mainRng.b,
+                              request->mainRng.c, request->mainRng.ctr}));
+        gRng2Value = (rng_value_t){request->secondaryRng.a, request->secondaryRng.b,
+                                  request->secondaryRng.c, request->secondaryRng.ctr};
+        AI_FLAGS(request->aiFlags);
+        for (partySlot = 0; partySlot < request->playerCount; partySlot++) {
+            struct moveWithPP moves[MAX_MON_MOVES];
+            OpenPokemon(__LINE__, B_SIDE_PLAYER, request->player[partySlot].species);
+            Nature_(__LINE__, request->player[partySlot].nature);
+            Ability_(__LINE__, request->player[partySlot].ability);
+            Item_(__LINE__, request->player[partySlot].item);
+            HPIV_(__LINE__, request->player[partySlot].ivs[0]);
+            AttackIV_(__LINE__, request->player[partySlot].ivs[1]);
+            DefenseIV_(__LINE__, request->player[partySlot].ivs[2]);
+            SpAttackIV_(__LINE__, request->player[partySlot].ivs[3]);
+            SpDefenseIV_(__LINE__, request->player[partySlot].ivs[4]);
+            SpeedIV_(__LINE__, request->player[partySlot].ivs[5]);
+            SidedexDynamicSetEVs(gBattleTestRunnerState->data.currentMon,
+                                 (unsigned short *)request->player[partySlot].evs);
+            Level_(__LINE__, request->player[partySlot].level);
+            MaxHP_(__LINE__, request->player[partySlot].maxHp);
+            HP_(__LINE__, request->player[partySlot].hp);
+            Status1_(__LINE__, request->player[partySlot].status1);
+            for (moveSlot = 0; moveSlot < MAX_MON_MOVES; moveSlot++) {
+                moves[moveSlot].moveId = request->player[partySlot].moves[moveSlot];
+                moves[moveSlot].pp = request->player[partySlot].pp[moveSlot];
+            }
+            MovesWithPP_(__LINE__, moves);
+            ClosePokemon(__LINE__);
+        }
+        for (partySlot = 0; partySlot < request->opponentCount; partySlot++) {
+            struct moveWithPP moves[MAX_MON_MOVES];
+            OpenPokemon(__LINE__, B_SIDE_OPPONENT, request->opponent[partySlot].species);
+            Nature_(__LINE__, request->opponent[partySlot].nature);
+            Ability_(__LINE__, request->opponent[partySlot].ability);
+            Item_(__LINE__, request->opponent[partySlot].item);
+            HPIV_(__LINE__, request->opponent[partySlot].ivs[0]);
+            AttackIV_(__LINE__, request->opponent[partySlot].ivs[1]);
+            DefenseIV_(__LINE__, request->opponent[partySlot].ivs[2]);
+            SpAttackIV_(__LINE__, request->opponent[partySlot].ivs[3]);
+            SpDefenseIV_(__LINE__, request->opponent[partySlot].ivs[4]);
+            SpeedIV_(__LINE__, request->opponent[partySlot].ivs[5]);
+            SidedexDynamicSetEVs(gBattleTestRunnerState->data.currentMon,
+                                 (unsigned short *)request->opponent[partySlot].evs);
+            Level_(__LINE__, request->opponent[partySlot].level);
+            MaxHP_(__LINE__, request->opponent[partySlot].maxHp);
+            HP_(__LINE__, request->opponent[partySlot].hp);
+            Status1_(__LINE__, request->opponent[partySlot].status1);
+            for (moveSlot = 0; moveSlot < MAX_MON_MOVES; moveSlot++) {
+                moves[moveSlot].moveId = request->opponent[partySlot].moves[moveSlot];
+                moves[moveSlot].pp = request->opponent[partySlot].pp[moveSlot];
+            }
+            MovesWithPP_(__LINE__, moves);
+            ClosePokemon(__LINE__);
+        }
+    } WHEN {
+        if (request->replayCount) {
+            TURN {
+                if (request->replay.playerKind == SIDEDEX_DYNAMIC_MOVE)
+                    MOVE(player, request->replay.playerMove);
+                else
+                    SWITCH(player, request->replay.playerSlot);
+                if (request->replay.opponentKind == SIDEDEX_DYNAMIC_MOVE)
+                    EXPECT_MOVE(opponent, request->replay.opponentMove);
+                else
+                    EXPECT_SWITCH(opponent, request->replay.opponentSlot);
+            }
+        }
+        TURN {
+            if (request->candidateKind == SIDEDEX_DYNAMIC_MOVE)
+                MOVE(player, request->playerMove);
+            else
+                SWITCH(player, request->playerSlot);
+        }
+        if (request->secondPresent) {
+            TURN {
+                if (request->secondKind == SIDEDEX_DYNAMIC_MOVE)
+                    MOVE(player, request->secondMove);
+                else
+                    SWITCH(player, request->secondSlot);
+            }
+        }
+    } SCENE {
+    }
+}
