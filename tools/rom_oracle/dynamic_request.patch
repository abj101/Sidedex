+// outside easy mode (src/battle_main.c STATE_WAIT_ACTION_CHOSEN). The AI has
+// already *decided* to use an item by then, so the resolved turn cannot
+// reproduce the query's item prediction. Report the refusal instead of
+// silently substituting the fallback move.
+void TestRunner_Battle_RejectTrainerItem(u32 battler, u32 item)
+{
+    if (!SidedexDynamicTraceActive() || sSidedexItemRefused)
+        return;
+    sSidedexItemRefused = TRUE;
+    Test_MgbaPrintf("ROMTRACE|unrepresentable|trainer-item-decision");
+    Test_MgbaPrintf("ROMTRACE|phase|%d|unrepresentable|trainer-item-decision",
+                    gBattleResults.battleTurnCounter);
+    Test_MgbaPrintf("ROMTRACE|phase|%d|item-refused|%d|%d",
+                    gBattleResults.battleTurnCounter, battler, item);
+}
+
+void TestRunner_Battle_ApplyTrainerItems(void)
+{
+    u32 i;
+    // Trainer items are copied into the battle history for BOTH the pre-choice
+    // query turn and a resolved SIMULATE_TURN, so the AI makes the real item
+    // decision in either case. A resolved turn cannot *execute* the item: in a
+    // trainer battle outside easy mode the ROM ruleset refuses
+    // B_ACTION_USE_ITEM (src/battle_main.c), and the AI then falls back to a
+    // move. That divergence is reported by TestRunner_Battle_RejectTrainerItem
+    // as `ROMTRACE|unrepresentable|trainer-item-decision` and the turn
+    // completes; it never stalls. (The v8 stall was a separate base-code bug:
+    // RecordedBattle_ClearBattlerAction underflowed the u16 record cursor for a
+    // battler with no recorded actions and wrote sBattleRecords[battler][65535],
+    // corrupting EWRAM. Fixed in src/recorded_battle.c.)
+    if (!SidedexDynamicTraceActive()
+     || gSidedexDynamicRequest.version != SIDEDEX_DYNAMIC_VERSION
+     || gSidedexDynamicRequest.trainerItemCount == 0)
+        return;
+    for (i = 0; i < MAX_TRAINER_ITEMS; i++)
+        gBattleResources->battleHistory->trainerItems[i] =
+            (i < gSidedexDynamicRequest.trainerItemCount)
+                ? gSidedexDynamicRequest.trainerItems[i] : ITEM_NONE;
+    gBattleResources->battleHistory->itemsNo = gSidedexDynamicRequest.trainerItemCount;
+}
+
+void TestRunner_Battle_TraceChosenItem(u32 battlerId, u32 itemId)
+{
+    if (SidedexOracleTraceActive())
+        Test_MgbaPrintf("ROMTRACE|action|%d|%d|item|%d",
+                        gBattleResults.battleTurnCounter, battlerId, itemId);
+}
+
+bool32 TestRunner_Battle_UsesCriticalPolicy(void)
+{
+    return SidedexDynamicTraceActive()
+        && gSidedexDynamicRequest.criticalPolicy == SIDEDEX_DYNAMIC_CRIT_ITEM_ABILITY_ONLY;
+}
+
+void TestRunner_Battle_TraceCritPolicy(u32 battler, u32 move, s32 actual, s32 ordinary)
+{
+    if (SidedexDynamicTraceActive() && actual != ordinary)
+        Test_MgbaPrintf("ROMTRACE|crit-policy-change|%d|%d|%d|%d|%d",
+                        gBattleResults.battleTurnCounter, battler, move, actual, ordinary);
+}
+
+void TestRunner_Battle_ApplyDynamicStages(void)
+{
+    static bool32 applied;
+    u32 battler;
+
+    if (!SidedexDynamicTraceActive() || applied)
+        return;
+    Test_MgbaPrintf("ROMTRACE|critical-policy|%s|%s",
+                    SidedexCriticalPolicyLabel(), SidedexCriticalPolicyMechanism());
+    applied = TRUE;
+    for (battler = 0; battler < gBattlersCount; battler++)
+    {
+        u32 slot = gBattleStruct->battlerPartyIndexes[battler];
+        const volatile struct SidedexDynamicMon *mon;
+        if (GetBattlerSide(battler) == B_SIDE_PLAYER)
+            mon = &gSidedexDynamicRequest.player[slot];
+        else
+            mon = &gSidedexDynamicRequest.opponent[slot];
+        gBattleMons[battler].statStages[STAT_ATK] = mon->statStages[0];
+        gBattleMons[battler].statStages[STAT_DEF] = mon->statStages[1];
+        gBattleMons[battler].statStages[STAT_SPEED] = mon->statStages[2];
+        gBattleMons[battler].statStages[STAT_SPATK] = mon->statStages[3];
+        gBattleMons[battler].statStages[STAT_SPDEF] = mon->statStages[4];
+        gBattleMons[battler].statStages[STAT_ACC] = mon->statStages[5];
+        gBattleMons[battler].statStages[STAT_EVASION] = mon->statStages[6];
+    }
+}
