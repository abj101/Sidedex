+static void SidedexQueryMove(u32 owner, u32 battlerAtk, u32 battlerDef, u32 move)
+{
+    u32 abilityAtk = GetBattlerAbility(battlerAtk);
+    u32 abilityDef = GetBattlerAbility(battlerDef);
+    u32 holdEffectAtk = GetBattlerHoldEffect(battlerAtk, TRUE);
+    u32 holdEffectDef = GetBattlerHoldEffect(battlerDef, TRUE);
+    u32 oldAttacker = gBattlerAttacker, oldTarget = gBattlerTarget;
+    u32 oldMove = gCurrentMove;
+    u32 flags = 0, roll, critDen = 1, accuracy, numerator = 0;
+    u32 minHits = 1, maxHits = 1;
+    u32 hitsMode = SIDEDEX_HITS_FIXED;
+    u32 rollDamage[2][16] = {{0}};
+    u32 minimum = UINT_MAX, maximum = 0, nonCritWeight, critWeight;
+    u32 denominator;
+    s32 critChance, ordinaryCritChance;
+
+    if (gMovesInfo[move].effect == EFFECT_MULTI_HIT)
+    {
+        flags |= SIDEDEX_QUERY_MULTI_HIT_RANGE | SIDEDEX_QUERY_MULTI_HIT_ENUMERATED;
+        minHits = 2;
+        maxHits = 5;
+        hitsMode = SIDEDEX_HITS_STANDARD;
+        if (abilityAtk == ABILITY_SKILL_LINK)
+        {
+            minHits = 5;
+            hitsMode = SIDEDEX_HITS_SKILL_LINK;
+        }
+        else if (holdEffectAtk == HOLD_EFFECT_LOADED_DICE)
+        {
+            minHits = 4;
+            hitsMode = SIDEDEX_HITS_LOADED_DICE;
+        }
+        else if (abilityAtk == ABILITY_BATTLE_BOND && move == MOVE_WATER_SHURIKEN
+              && gBattleMons[battlerAtk].species == SPECIES_GRENINJA_ASH)
+        {
+            minHits = maxHits = 3;
+            hitsMode = SIDEDEX_HITS_BATTLE_BOND;
+        }
+    }
+    else if (gMovesInfo[move].strikeCount > 1 && gMovesInfo[move].effect == EFFECT_HIT)
+    {
+        flags |= SIDEDEX_QUERY_MULTI_HIT_RANGE | SIDEDEX_QUERY_MULTI_HIT_ENUMERATED;
+        minHits = maxHits = gMovesInfo[move].strikeCount;
+        hitsMode = SIDEDEX_HITS_FIXED;
+    }
+    else if (gMovesInfo[move].strikeCount > 1 || gMovesInfo[move].effect == EFFECT_TRIPLE_KICK)
+        flags |= SIDEDEX_QUERY_UNSUPPORTED;
+    if (gMovesInfo[move].category != DAMAGE_CATEGORY_STATUS && gMovesInfo[move].power == 0)
+        flags |= SIDEDEX_QUERY_UNSUPPORTED;
+
+    if ((flags & SIDEDEX_QUERY_UNSUPPORTED) && !(flags & SIDEDEX_QUERY_MULTI_HIT_RANGE))
+    {
+        Test_MgbaPrintf("ROMTRACE|query|damage|%d|%d|0|0|%d|0|0|0|0",
+                        owner, move, flags);
+        SidedexEmitOutcomesRefused(owner, move, flags);
+        return;
+    }
+    if (gMovesInfo[move].category == DAMAGE_CATEGORY_STATUS)
+    {
+        Test_MgbaPrintf("ROMTRACE|query|damage|%d|%d|0|1600|0|0|0|0|1", owner, move);
+        SidedexEmitOutcomeWeights(owner, move, battlerDef, rollDamage, 0, 0, 100,
+                                  1, 1, SIDEDEX_HITS_FIXED, flags);
+        return;
+    }
+
+    gBattlerAttacker = battlerAtk;
+    gBattlerTarget = battlerDef;
+    gCurrentMove = move;
+    accuracy = min(100, GetTotalAccuracy(battlerAtk, battlerDef, move,
+                                         abilityAtk, abilityDef,
+                                         holdEffectAtk, holdEffectDef));
+    critChance = CalcCritChanceStage(battlerAtk, battlerDef, move, FALSE,
+                                     abilityAtk, abilityDef, holdEffectAtk);
+    if (gSidedexDynamicRequest.criticalPolicy == SIDEDEX_DYNAMIC_CRIT_ITEM_ABILITY_ONLY)
+    {
+        ordinaryCritChance = CalcCritChanceStage(battlerAtk, battlerDef, move, FALSE,
+                                                 ABILITY_NONE, ABILITY_NONE, HOLD_EFFECT_NONE);
+        // Ordinary crit odds (including high-crit moves and Laser Focus) are not
+        // part of the item-ability-only policy. Retain crit only when an enabled
+        // ability or held item changes the engine's crit state. The `normal`
+        // policy keeps the real engine roll weights (parity mode).
+        if (critChance == ordinaryCritChance)
+            critChance = CRITICAL_HIT_BLOCKED;
+    }
+    if (critChance >= 0)
+        critDen = GetCritHitOdds(critChance);
+    nonCritWeight = critChance == CRITICAL_HIT_ALWAYS ? 0
+                  : critChance == CRITICAL_HIT_BLOCKED ? 1 : critDen - 1;
+    critWeight = critChance == CRITICAL_HIT_ALWAYS ? 1
+               : critChance == CRITICAL_HIT_BLOCKED ? 0 : 1;
+
+    if (holdEffectDef == HOLD_EFFECT_FOCUS_SASH
+     && gBattleMons[battlerDef].hp == gBattleMons[battlerDef].maxHP)
+        flags |= SIDEDEX_QUERY_FOCUS_SASH;
+    if (B_STURDY >= GEN_5 && abilityDef == ABILITY_STURDY
+     && gBattleMons[battlerDef].hp == gBattleMons[battlerDef].maxHP)
+        flags |= SIDEDEX_QUERY_STURDY;
+
+    for (roll = 0; roll < 16; roll++)
+    {
+        u32 damage;
+        if (nonCritWeight)
+        {
+            damage = SidedexQueryDamage(battlerAtk, battlerDef, move, FALSE, roll);
+            rollDamage[0][roll] = damage;
+            minimum = min(minimum, damage);
+            maximum = max(maximum, damage);
+            if (damage >= gBattleMons[battlerDef].hp)
+                numerator += nonCritWeight;
+        }
+        if (critWeight)
+        {
+            damage = SidedexQueryDamage(battlerAtk, battlerDef, move, TRUE, roll);
+            rollDamage[1][roll] = damage;
+            minimum = min(minimum, damage);
+            maximum = max(maximum, damage);
+            if (damage >= gBattleMons[battlerDef].hp)
+                numerator += critWeight;
+        }
+    }
+
+    if (flags & SIDEDEX_QUERY_MULTI_HIT_RANGE)
+    {
+        minimum *= minHits;
+        maximum *= maxHits;
+        numerator = denominator = 0;
+    }
+    else
+    {
+        if (flags & (SIDEDEX_QUERY_FOCUS_SASH | SIDEDEX_QUERY_STURDY)
+         || gMovesInfo[move].effect == EFFECT_FALSE_SWIPE)
+            numerator = 0;
+        numerator *= accuracy;
+        denominator = 100 * 16 * critDen;
+    }
+    if (minimum == UINT_MAX)
+        minimum = 0;
+    Test_MgbaPrintf("ROMTRACE|query|damage|%d|%d|%d|%d|%d|%d|%d|%d|%d",
+                    owner, move, numerator, denominator, flags, minimum, maximum,
+                    accuracy, critDen);
+    if (flags & SIDEDEX_QUERY_MULTI_HIT_ENUMERATED)
+    {
+        Test_MgbaPrintf("ROMTRACE|query|hits|%d|%d|%d|%d|%d|%d|%d",
+                        owner, move, hitsMode, minHits, maxHits, nonCritWeight, critWeight);
+        Test_MgbaPrintf("ROMTRACE|query|hitroll|%d|%d|0|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d",
+                        owner, move,
+                        rollDamage[0][0], rollDamage[0][1], rollDamage[0][2], rollDamage[0][3],
+                        rollDamage[0][4], rollDamage[0][5], rollDamage[0][6], rollDamage[0][7],
+                        rollDamage[0][8], rollDamage[0][9], rollDamage[0][10], rollDamage[0][11],
+                        rollDamage[0][12], rollDamage[0][13], rollDamage[0][14], rollDamage[0][15]);
+        Test_MgbaPrintf("ROMTRACE|query|hitroll|%d|%d|1|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d",
+                        owner, move,
+                        rollDamage[1][0], rollDamage[1][1], rollDamage[1][2], rollDamage[1][3],
+                        rollDamage[1][4], rollDamage[1][5], rollDamage[1][6], rollDamage[1][7],
+                        rollDamage[1][8], rollDamage[1][9], rollDamage[1][10], rollDamage[1][11],
+                        rollDamage[1][12], rollDamage[1][13], rollDamage[1][14], rollDamage[1][15]);
+    }
+    // Complete outcome-weight enumeration for this move (contract phase 2).
+    SidedexEmitOutcomeWeights(owner, move, battlerDef, rollDamage, nonCritWeight,
+                              critWeight, accuracy, minHits, maxHits, hitsMode, flags);
+    gBattlerAttacker = oldAttacker;
+    gBattlerTarget = oldTarget;
+    gCurrentMove = oldMove;
+}
+
+// Complete outcome-weight enumeration (see SidedexEmitOutcomeWeights).
+static u32 SidedexDynamicPartySlot(u32 battler)
+{
+    const volatile struct SidedexDynamicMon *party;
+    u32 count, i, j;
+    struct BattlePokemon *active = &gBattleMons[battler];
+    if (GetBattlerSide(battler) == B_SIDE_PLAYER)
+    {
+        party = gSidedexDynamicRequest.player;
+        count = gSidedexDynamicRequest.playerCount;
+    }
+    else
+    {
+        party = gSidedexDynamicRequest.opponent;
+        count = gSidedexDynamicRequest.opponentCount;
+    }
+    for (i = 0; i < count; i++)
+    {
+        if (party[i].species != active->species || party[i].ability != active->ability)
+            continue;
+        for (j = 0; j < MAX_MON_MOVES; j++)
+            if (party[i].moves[j] != active->moves[j])
+                break;
+        if (j == MAX_MON_MOVES)
+            return i;
+    }
+    return gBattleStruct->battlerPartyIndexes[battler];
+}
