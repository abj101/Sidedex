+// TRUE stops the pump for this frame: boundary hold, terminal, or budget.
+bool32 TestRunner_Battle_LogicPumpYield(void)
+{
+    if (!SidedexDynamicLogicOnly())
+        return TRUE;
+    sSidedexInstructions++;
+    if (sSidedexInstructions > 2000000)
+    {
+        if (!sSidedexBudgetReported)
+        {
+            sSidedexBudgetReported = TRUE;
+            TestRunner_Battle_BudgetExceeded(sSidedexInstructions);
+        }
+        return TRUE;
+    }
+    if (sSidedexBoundaryHold || gBattleOutcome != 0 || NoAliveMonsForEitherParty())
+        return TRUE;
+    return FALSE;
