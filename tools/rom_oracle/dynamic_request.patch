+static void SidedexOracleTraceBlob(u32 turn, u32 owner, u32 index, const char *kind, const void *data, u32 size)
+{
+    static const char digits[] = "0123456789abcdef";
+    const u8 *bytes = data;
+    char hex[65];
+    u32 offset, i, count;
+
+    for (offset = 0; offset < size; offset += 32)
+    {
+        count = min(32, size - offset);
+        for (i = 0; i < count; i++)
+        {
+            hex[i * 2] = digits[bytes[offset + i] >> 4];
+            hex[i * 2 + 1] = digits[bytes[offset + i] & 0xF];
+        }
+        hex[count * 2] = '\0';
+        Test_MgbaPrintf("ROMTRACE|blob|%d|%d|%d|%s|%d|%s", turn, owner, index, kind, offset / 32, hex);
+    }
+}
