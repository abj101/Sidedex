diff --git a/include/test/sidedex_dynamic.h b/include/test/sidedex_dynamic.h
new file mode 100644
index 0000000000..bc03530307
--- /dev/null
+++ b/include/test/sidedex_dynamic.h
@@ -0,0 +1,136 @@
+#ifndef SIDEDEX_DYNAMIC_H
+#define SIDEDEX_DYNAMIC_H
+
+#define SIDEDEX_DYNAMIC_MAGIC 0x53445831
+#define SIDEDEX_DYNAMIC_VERSION 9
+#define SIDEDEX_DYNAMIC_TEST_NAME "Sidedex oracle: dynamic AI singles request"
+#define SIDEDEX_DYNAMIC_PARTY_LIMIT PARTY_SIZE
+#define SIDEDEX_DYNAMIC_MAX_TRAINER_ITEMS 4
+#define SIDEDEX_DYNAMIC_REQUEST_BYTES 876
+#define SIDEDEX_DYNAMIC_RESULT_BYTES 8192
+#define SIDEDEX_BOUNDARY_NONE 0
+#if TESTING
+#define SIDEDEX_LOGIC_ONLY 1
+#endif
+
+enum SidedexDynamicAction
+{
+    SIDEDEX_DYNAMIC_MOVE,
+    SIDEDEX_DYNAMIC_SWITCH,
+    // candidateKind 2: the expansion trainer AI chooses the PLAYER battler's
+    // action (move+target, voluntary switch, or forced faint replacement).
+    // AI flags = the opponent's flags | SMART_SWITCHING | SMART_MON_CHOICES.
+    // playerMove/playerSlot are ignored. Not valid inside replay/second turns.
+    SIDEDEX_DYNAMIC_AI,
+};
+
+// Explicit operation field (v8). SIDEDEX_DYNAMIC_SIMULATE_TURN keeps the
+// historical secondPresent==2 query behaviour reachable when op is left at 0.
+enum SidedexDynamicOp
+{
+    SIDEDEX_DYNAMIC_SIMULATE_TURN,
+    SIDEDEX_DYNAMIC_QUERY_DAMAGE,
+    SIDEDEX_DYNAMIC_QUERY_AI_ACTION,
+};
+
+enum SidedexDynamicMode
+{
+    SIDEDEX_DYNAMIC_MODE_NORMAL,
+    SIDEDEX_DYNAMIC_MODE_LOGIC_ONLY,
+};
+
+enum SidedexDynamicCriticalPolicy
+{
+    SIDEDEX_DYNAMIC_CRIT_NORMAL,
+    SIDEDEX_DYNAMIC_CRIT_ITEM_ABILITY_ONLY,
+};
+
+enum SidedexDynamicStatus
+{
+    SIDEDEX_DYNAMIC_WAITING,
+    SIDEDEX_DYNAMIC_SUBMITTED,
+    SIDEDEX_DYNAMIC_RUNNING,
+    SIDEDEX_DYNAMIC_COMPLETE,
+    SIDEDEX_DYNAMIC_INVALID,
+};
+
+struct SidedexDynamicRng
+{
+    unsigned int a, b, c, ctr;
+};
+
+struct SidedexDynamicMon
+{
+    unsigned short species, level, ability, item;
+    unsigned short nature, hp, maxHp, reserved;
+    unsigned int status1;
+    unsigned short moves[4];
+    unsigned char pp[4];
+    unsigned short ivs[6], evs[6];
+    unsigned char heldItemEnabled, statStages[7];
+};
+
+struct SidedexDynamicTurn
+{
+    unsigned short playerKind, playerMove, playerSlot;
+    unsigned short opponentKind, opponentMove, opponentSlot;
+};
+
+struct SidedexDynamicRequest
+{
+    unsigned int magic;
+    unsigned short version, status;
+    unsigned int aiFlags;
+    unsigned short candidateKind, playerMove, playerSlot, replayCount;
+    struct SidedexDynamicRng mainRng, secondaryRng;
+    unsigned short playerCount, opponentCount;
+    struct SidedexDynamicMon player[SIDEDEX_DYNAMIC_PARTY_LIMIT];
+    struct SidedexDynamicMon opponent[SIDEDEX_DYNAMIC_PARTY_LIMIT];
+    struct SidedexDynamicTurn replay;
+    // v7 compatibility tail. secondPresent: 0 = none, 1 = a second scripted
+    // turn follows, 2 = pre-choice query turn, 3 = forced-switch scenario (the
+    // candidate turn is expected to faint the player's active monster and
+    // secondSlot is the recorded compulsory-replacement party index; the ROM
+    // holds at the forced-switch boundary and injects the real choice).
+    unsigned short secondKind, secondMove, secondSlot, secondPresent;
+    unsigned short trainerItems[SIDEDEX_DYNAMIC_MAX_TRAINER_ITEMS];
+    unsigned short trainerItemCount;
+    unsigned short trainerReserved;
+    // v8 extension. Byte offsets are frozen in the contract appendix:
+    // op=856, mode=858, criticalPolicy=860, requestId=862 (total 864 bytes).
+    // requestId is a caller-chosen monotonic token: the boundary hold releases
+    // only when a submitted request carries a different requestId than the one
+    // that created the hold.
+    unsigned short op, mode, criticalPolicy, requestId;
+    unsigned int resultAddress, resultCapacity;
+    unsigned short resultVersion, flags;
+};
+
+// Request flags (v9). Bit 0 is compact transport; bits 1-2 carry the difficulty
+// override (contract Appendix C.6) so a caller can give the ROM the game setting
+// it reads at src/battle_main.c:4510 without moving the mailbox. Every other bit
+// must be zero and is rejected by SidedexDynamicRequestValid.
+#define SIDEDEX_DYNAMIC_FLAG_COMPACT           0x0001
+#define SIDEDEX_DYNAMIC_DIFFICULTY_MASK        0x0006
+#define SIDEDEX_DYNAMIC_DIFFICULTY_SHIFT       1
+#define SIDEDEX_DYNAMIC_DIFFICULTY_KEEP        0 // do not touch VAR_GAME_SETTING_DIFFICULTY_MODE
+#define SIDEDEX_DYNAMIC_DIFFICULTY_EASY        1 // GAME_SETTING_DIFFICULTY_EASY_MODE
+#define SIDEDEX_DYNAMIC_DIFFICULTY_NORMAL      2 // GAME_SETTING_DIFFICULTY_NORMAL_MODE
+#define SIDEDEX_DYNAMIC_DIFFICULTY_RESERVED    3 // no such ROM setting; REFUSED
+#define SIDEDEX_DYNAMIC_FLAGS_KNOWN \
+    (SIDEDEX_DYNAMIC_FLAG_COMPACT | SIDEDEX_DYNAMIC_DIFFICULTY_MASK)
+
+extern volatile struct SidedexDynamicRequest gSidedexDynamicRequest;
+extern u8 *gSidedexDynamicResult;
+void SidedexDynamicSetEVs(struct Pokemon *mon, unsigned short evs[6]);
+#if TESTING
+void SidedexDynamicInjectPlayerAction(u32 battler, u8 *action, u8 *byte1, u8 *byte2);
+#else
+#define SidedexDynamicInjectPlayerAction(...) (void)0
+#endif
+bool32 SidedexDynamicActive(void);
+bool32 SidedexDynamicLogicOnly(void);
+bool32 SidedexDynamicInjectedActionPending(void);
+void SidedexDynamicResetRequest(void);
+
+#endif
