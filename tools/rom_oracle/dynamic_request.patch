+// Called by the recorded player controller. The recorded bytes are still
+// consumed so the playback cursor stays aligned; only the returned value is
+// replaced. kind/byte1/byte2 are the ROM's own defaults.
+void SidedexDynamicInjectPlayerAction(u32 battler, u8 *action, u8 *byte1, u8 *byte2)
+{
+    if (!sSidedexInjectPending || battler != GetBattlerAtPosition(B_POSITION_PLAYER_LEFT))
+        return;
+    if (sSidedexInjectKind == SIDEDEX_DYNAMIC_MOVE)
+    {
+        u32 i;
+        for (i = 0; i < MAX_MON_MOVES; i++)
+        {
+            if (gBattleMons[battler].moves[i] == sSidedexInjectMove)
+            {
+                sSidedexInjectMoveSlot = i;
+                break;
+            }
+        }
+        *action = B_ACTION_USE_MOVE;
+        *byte1 = sSidedexInjectMoveSlot;
+        // Leave *byte2 (the recorded move target) untouched: replacing it with a
+        // default makes the move target the player's own battler.
+    }
+    else
+    {
+        *action = B_ACTION_SWITCH;
+        *byte1 = sSidedexInjectSlot & 0xFF;
+    }
+}
